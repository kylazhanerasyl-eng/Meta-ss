def test_duplicate_application_blocked():
    """Тест целостности БД: запрет дубликатов Application UNIQUE(student_id, topic_id) на уровне БД"""
    from sqlalchemy.exc import IntegrityError
    from main import SessionLocal, User, Topic, Application, hash_password
    db = SessionLocal()
    st_email = f"st_uq_app_{uuid.uuid4().hex[:6]}@test.com"
    user = None
    topic = None
    try:
        user = User(
            full_name="Тестовый Студент UNIQUE APP",
            email=st_email,
            password_hash=hash_password("123456"),
            role="student",
            is_active=True
        )
        db.add(user)
        db.commit()

        topic = Topic(
            title=f"Тема для UNIQUE APP {uuid.uuid4().hex[:6]}",
            supervisor_name="Доц. Ахметов К.А.",
            quota_total=5,
            quota_used=0,
            status="available"
        )
        db.add(topic)
        db.commit()

        app1 = Application(student_id=user.id, topic_id=topic.id, priority=1, status="SUBMITTED")
        db.add(app1)
        db.commit()

        app2 = Application(student_id=user.id, topic_id=topic.id, priority=2, status="SUBMITTED")
        db.add(app2)
        with pytest.raises(IntegrityError):
            db.commit()
        db.rollback()
    finally:
        try:
            db.rollback()
            if user:
                db.query(Application).filter(Application.student_id == user.id).delete()
            if topic:
                db.query(Topic).filter(Topic.id == topic.id).delete()
            if user:
                db.query(User).filter(User.id == user.id).delete()
            db.commit()
        except Exception:
            db.rollback()
        db.close()

