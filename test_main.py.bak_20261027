import uuid
from io import BytesIO
import pytest
from fastapi.testclient import TestClient
from main import app, calculate_similarity

client = TestClient(app)

def get_auth_token(email: str, password: str = "123456") -> str:
    res = client.post("/api/login", json={"email": email, "password": password})
    assert res.status_code == 200, f"Login failed for {email}: {res.text}"
    return res.json()["token"]

@pytest.fixture(scope="function", autouse=True)
def ensure_available_topic_quota():
    from main import SessionLocal, Topic
    db = SessionLocal()
    try:
        # Guarantee topic 1, 3, 5 have available quota for tests
        for t in db.query(Topic).all():
            if t.quota_used >= t.quota_total:
                t.quota_used = max(0, t.quota_total - 2)
                t.status = "available"
        db.commit()
    finally:
        db.close()

