        "/api/norm-control/check-docx",
        files={"file": ("document.txt", fake_file, "text/plain")}
    )
    assert res.status_code == 400
    assert "docx" in res.text

def test_checkpoints_lifecycle():
    """Тест: проверка жизненного цикла контрольных точек ВКР"""
    student_headers = {"Authorization": f"Bearer {get_auth_token('student@test.com')}"}
    teacher_headers = {"Authorization": f"Bearer {get_auth_token('teacher@test.com')}"}
    # Establish the actual supervisory relationship required to read/review reports.
    applied = client.post("/api/applications/apply", json={"topic_id": 1, "priority": 1}, headers=student_headers)
    assert applied.status_code == 200
    approved = client.post("/api/applications/decide", json={"application_id": applied.json()["application_id"], "decision": "APPROVE"}, headers=teacher_headers)
    assert approved.status_code == 200
    cps_res = client.get("/api/checkpoints/1", headers=student_headers)
    assert cps_res.status_code == 200
    cps_data = cps_res.json()
    assert "checkpoints" in cps_data
    assert len(cps_data["checkpoints"]) == 4
    cp = cps_data["checkpoints"][0]
    cp_id = cp["id"]

    sample_pdf = b"%PDF-1.4 test report content for checkpoint"
    upload_res = client.post(
        "/api/checkpoints/upload",
        data={"checkpoint_id": cp_id},
        files={"file": ("report_stage1.pdf", BytesIO(sample_pdf), "application/pdf")}, headers=student_headers
    )
    assert upload_res.status_code == 200
    upload_data = upload_res.json()
    assert upload_data["status"] == "UNDER_REVIEW"

    t_res = client.get("/api/teacher/checkpoints", headers=teacher_headers)
    assert t_res.status_code == 200

    review_res = client.post("/api/checkpoints/review", json={
        "checkpoint_id": cp_id,
        "status": "ACCEPTED",
        "comment": "Отличная работа, замечаний нет."
    }, headers=teacher_headers)
    assert review_res.status_code == 200
    assert review_res.json()["status"] == "ACCEPTED"

    dl_res = client.get(f"/api/checkpoints/download/{cp_id}", headers=student_headers)
    assert dl_res.status_code == 200
    assert dl_res.content == sample_pdf

