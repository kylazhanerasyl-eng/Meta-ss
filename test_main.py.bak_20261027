# ─── APPLICATION & QUOTA BUSINESS LOGIC TESTS ────────────────────────────────
def test_double_approve():
    """Тест: одну заявку нельзя approve два раза, повторный approve НЕ увеличивает quota_used"""
    teacher_token = get_auth_token("teacher@test.com")
    headers_teacher = {"Authorization": f"Bearer {teacher_token}"}

    st_email = f"st_dbl_app_{uuid.uuid4().hex[:6]}@test.com"
    client.post("/api/register", json={"full_name": "Студент Дабл Аппрув", "email": st_email, "password": "123456", "role": "student"})
    st_token = get_auth_token(st_email)

    app_res = client.post("/api/applications/apply", json={"topic_id": 1, "priority": 1}, headers={"Authorization": f"Bearer {st_token}"})
    assert app_res.status_code == 200
    app_id = app_res.json()["application_id"]

    from main import SessionLocal, Topic
    db = SessionLocal()
    quota_before = db.query(Topic).filter(Topic.id == 1).first().quota_used
    db.close()

    # Первый approve
    res1 = client.post("/api/applications/decide", json={"application_id": app_id, "decision": "APPROVE"}, headers=headers_teacher)
    assert res1.status_code == 200
    assert res1.json()["status"] == "APPROVED"

    db = SessionLocal()
    quota_after1 = db.query(Topic).filter(Topic.id == 1).first().quota_used
    assert quota_after1 == quota_before + 1
    db.close()

    # Повторный approve должен быть отклонен (код 400)
    res2 = client.post("/api/applications/decide", json={"application_id": app_id, "decision": "APPROVE"}, headers=headers_teacher)
    assert res2.status_code == 400
    assert "уже одобрена" in res2.text or "уже утверждена" in res2.text

    # Повторный approve НЕ должен увеличить quota_used
    db = SessionLocal()
    quota_after2 = db.query(Topic).filter(Topic.id == 1).first().quota_used
    assert quota_after2 == quota_after1
    db.close()

def test_two_approved_topics():
    """Тест: один студент не может получить две APPROVED/CONFIRMED темы"""
    teacher_token = get_auth_token("teacher@test.com")
    headers_teacher = {"Authorization": f"Bearer {teacher_token}"}

    st_email = f"st_two_app_{uuid.uuid4().hex[:6]}@test.com"
    client.post("/api/register", json={"full_name": "Студент Две Темы", "email": st_email, "password": "123456", "role": "student"})
    st_token = get_auth_token(st_email)

    # Подаем 2 заявки на разные темы одного преподавателя (тема 1 и тема 3)
    res1 = client.post("/api/applications/apply", json={"topic_id": 1, "priority": 1}, headers={"Authorization": f"Bearer {st_token}"})
    assert res1.status_code == 200
    app1_id = res1.json()["application_id"]

    res2 = client.post("/api/applications/apply", json={"topic_id": 3, "priority": 2}, headers={"Authorization": f"Bearer {st_token}"})
    assert res2.status_code == 200
    app2_id = res2.json()["application_id"]

    # Одобряем 1-ю тему
    dec1 = client.post("/api/applications/decide", json={"application_id": app1_id, "decision": "APPROVE"}, headers=headers_teacher)
    assert dec1.status_code == 200
    assert dec1.json()["status"] == "APPROVED"

    # Попытка одобрить 2-ю тему блокируется (400)
    dec2 = client.post("/api/applications/decide", json={"application_id": app2_id, "decision": "APPROVE"}, headers=headers_teacher)
    assert dec2.status_code == 400
    assert "уже есть одобренная" in dec2.text or "уже распределен" in dec2.text

def test_quota_never_exceeded():
    """Тест: quota_used никогда не превышает quota_total"""
    teacher_token = get_auth_token("teacher@test.com")
    headers_teacher = {"Authorization": f"Bearer {teacher_token}"}

    from main import SessionLocal, Topic
    db = SessionLocal()
    t = db.query(Topic).filter(Topic.id == 5).first()
    orig_total = t.quota_total
    orig_used = t.quota_used
    orig_status = t.status
    # Установим лимит: квота total = 2, used = 1
    t.quota_total = 2
    t.quota_used = 1
    t.status = "available"
    db.commit()
    topic_id = t.id
    db.close()

    try:
        # Студент 1 занимает последнее место (used становится 2)
        st1_email = f"st_q1_{uuid.uuid4().hex[:6]}@test.com"
        client.post("/api/register", json={"full_name": "Студент Квота 1", "email": st1_email, "password": "123456", "role": "student"})
        res1 = client.post("/api/applications/apply", json={"topic_id": topic_id, "priority": 1}, headers={"Authorization": f"Bearer {get_auth_token(st1_email)}"})
        app1_id = res1.json()["application_id"]
        client.post("/api/applications/decide", json={"application_id": app1_id, "decision": "APPROVE"}, headers=headers_teacher)

        # Студент 2 пытается податься или одобриться сверх квоты
        st2_email = f"st_q2_{uuid.uuid4().hex[:6]}@test.com"
        client.post("/api/register", json={"full_name": "Студент Квота 2", "email": st2_email, "password": "123456", "role": "student"})
        res2 = client.post("/api/applications/apply", json={"topic_id": topic_id, "priority": 1}, headers={"Authorization": f"Bearer {get_auth_token(st2_email)}"})
        assert res2.status_code == 400
        assert "TOPIC_FULL" in res2.text

        # Проверяем в БД: quota_used строго не превышает quota_total
        db = SessionLocal()
        t_after = db.query(Topic).filter(Topic.id == topic_id).first()
        assert t_after.quota_used <= t_after.quota_total
        db.close()
    finally:
        db = SessionLocal()
        t = db.query(Topic).filter(Topic.id == 5).first()
        t.quota_total = orig_total
        t.quota_used = orig_used
        t.status = orig_status
        db.commit()
        db.close()

