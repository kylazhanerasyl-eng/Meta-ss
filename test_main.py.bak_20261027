        fake_email = f"hacker_{forbidden_role}_{uuid.uuid4().hex[:6]}@test.com"
        res = client.post("/api/register", json={
            "full_name": f"Hacker {forbidden_role}",
            "email": fake_email,
            "password": "secretpassword123",
            "role": forbidden_role
        })
        assert res.status_code == 403
        assert "student" in res.text.lower()

