def test_duplicate_application():
    """Тест 11: запрет подачи на одну тему дважды (400)"""
    st_email = f"dup_st_{uuid.uuid4().hex[:6]}@test.com"
    client.post("/api/register", json={
        "full_name": "Дублирующий Студент",
        "email": st_email,
        "password": "123456",
        "role": "student"
    })
    token = get_auth_token(st_email)
    headers = {"Authorization": f"Bearer {token}"}

    res1 = client.post("/api/applications/apply", json={"topic_id": 4, "priority": 1}, headers=headers)
    assert res1.status_code == 200

    res2 = client.post("/api/applications/apply", json={"topic_id": 4, "priority": 2}, headers=headers)
    assert res2.status_code == 400
    assert "уже подали заявку на эту тему" in res2.text

