def test_websocket_wrong_user_rejected():
    """Регрессионный тест 5: websocket wrong user -> rejected"""
    from starlette.websockets import WebSocketDisconnect
    student_token = get_auth_token("student@test.com")
    # student@test.com имеет user_id=1, пробуем подключиться к чужому user_id=5 (teacher)
    with pytest.raises(WebSocketDisconnect) as exc_info:
        with client.websocket_connect(f"/ws/5?token={student_token}"):
            pass
    assert exc_info.value.code == 1008

def test_websocket_without_token_rejected():
    """Регрессионный тест: websocket without token -> rejected"""
    from starlette.websockets import WebSocketDisconnect
    with pytest.raises(WebSocketDisconnect) as exc_info:
        with client.websocket_connect("/ws/1"):
            pass
    assert exc_info.value.code == 1008

def test_session_expiration_rejected():
    """Регрессионный тест: истекшая сессия возвращает 401 и отклоняет WebSocket"""
    from datetime import datetime, timedelta
    from main import SessionLocal, SessionModel
    from starlette.websockets import WebSocketDisconnect

    _db = SessionLocal()
    expired_token = f"exp_token_{uuid.uuid4().hex}"
    try:
        sess = SessionModel(
            user_id=1,
            token=expired_token,
            created_at=datetime.utcnow() - timedelta(days=10),
            expires_at=datetime.utcnow() - timedelta(hours=1)
        )
        _db.add(sess)
        _db.commit()
    finally:
        _db.close()

    res = client.get("/api/head/stats", headers={"Authorization": f"Bearer {expired_token}"})
    assert res.status_code == 401

    with pytest.raises(WebSocketDisconnect) as exc_info:
        with client.websocket_connect(f"/ws/1?token={expired_token}"):
            pass
    assert exc_info.value.code == 1008

def test_all_protected_endpoints_require_bearer():
    """Регрессионный тест: эндпоинты /api/decide, /api/allocation/*, /api/export/* требуют Bearer token (401)"""
    assert client.post("/api/decide", json={"application_id": 1, "decision": "APPROVE"}).status_code == 401
    assert client.post("/api/allocation/gale-shapley").status_code == 401
    assert client.get("/api/export/official-decree-docx").status_code == 401
    assert client.get("/api/export/pdf-order").status_code == 401
    assert client.get("/api/export/order").status_code == 401
    assert client.get("/api/export/statement/1").status_code == 401

