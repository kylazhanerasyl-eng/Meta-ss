def test_concurrent_atomic_quota_scenario():
    """Тест: проверка квоты и инкремент атомарны в транзакции, квота не превышается при параллельных запросах"""
    import concurrent.futures
    teacher_token = get_auth_token("teacher@test.com")
    headers_teacher = {"Authorization": f"Bearer {teacher_token}"}

    from main import SessionLocal, Topic
    db = SessionLocal()
    t = db.query(Topic).filter(Topic.id == 1).first()
    orig_used = t.quota_used
    orig_total = t.quota_total
    # Оставляем ровно 1 свободное место
    t.quota_total = 5
    t.quota_used = 4
    t.status = "available"
    db.commit()
    topic_id = t.id
    db.close()

    try:
        # Два студента успевают подать заявку
        app_ids = []
        for i in range(2):
            st_email = f"st_conc_{i}_{uuid.uuid4().hex[:6]}@test.com"
            client.post("/api/register", json={"full_name": f"Студент Гонка {i}", "email": st_email, "password": "123456", "role": "student"})
            res = client.post("/api/applications/apply", json={"topic_id": topic_id, "priority": 1}, headers={"Authorization": f"Bearer {get_auth_token(st_email)}"})
            app_ids.append(res.json()["application_id"])

        def do_approve(app_id):
            return client.post("/api/applications/decide", json={"application_id": app_id, "decision": "APPROVE"}, headers=headers_teacher)

        with concurrent.futures.ThreadPoolExecutor(max_workers=2) as executor:
            responses = list(executor.map(do_approve, app_ids))

        status_codes = [r.status_code for r in responses]
        assert 200 in status_codes
        assert 400 in status_codes
        fail_resp = [r for r in responses if r.status_code == 400][0]
        assert "TOPIC_FULL" in fail_resp.text

        db = SessionLocal()
        t_check = db.query(Topic).filter(Topic.id == topic_id).first()
        assert t_check.quota_used == 5
        assert t_check.quota_used <= t_check.quota_total
        db.close()
    finally:
        db = SessionLocal()
        t = db.query(Topic).filter(Topic.id == 1).first()
        t.quota_used = orig_used
        t.quota_total = orig_total
        t.status = "available"
        db.commit()
        db.close()

