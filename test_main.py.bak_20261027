def test_full_topic():
    """Тест 13: запрет подачи на переполненную тему (400)"""
    topics = client.get("/api/topics").json()
    target_topic = topics[0]

    st_email = f"full_st_{uuid.uuid4().hex[:6]}@test.com"
    client.post("/api/register", json={
        "full_name": "Студент Тест Квоты",
        "email": st_email,
        "password": "123456",
        "role": "student"
    })
    token = get_auth_token(st_email)
    headers = {"Authorization": f"Bearer {token}"}

    # Имитируем заполненную квоту через DB или проверку если full
    from main import SessionLocal, Topic as DBTopic
    db = SessionLocal()
    db_topic = db.query(DBTopic).filter(DBTopic.id == target_topic["id"]).first()
    original_quota = db_topic.quota_used
    original_status = db_topic.status
    try:
        db_topic.quota_used = db_topic.quota_total
        db_topic.status = "full"
        db.commit()

        res = client.post("/api/applications/apply", json={"topic_id": target_topic["id"], "priority": 1}, headers=headers)
        assert res.status_code == 400
        assert "исчерпаны" in res.text or "заняты" in res.text
    finally:
        db_topic.quota_used = original_quota
        db_topic.status = original_status
        db.commit()
        db.close()

def test_teacher_approve():
    """Тест 14: преподаватель успешно одобряет заявку на свою тему"""
    teacher_token = get_auth_token("teacher@test.com")
    headers_teacher = {"Authorization": f"Bearer {teacher_token}"}

    # Создаем заявку от студента на тему преподавателя (topic_id=1, Доц. Ахметов)
    st_email = f"approve_st_{uuid.uuid4().hex[:6]}@test.com"
    client.post("/api/register", json={"full_name": "Одобряемый Студент", "email": st_email, "password": "123456", "role": "student"})
    st_token = get_auth_token(st_email)

    app_res = client.post("/api/applications/apply", json={"topic_id": 1, "priority": 1}, headers={"Authorization": f"Bearer {st_token}"})
    assert app_res.status_code == 200
    app_id = app_res.json()["application_id"]

    # Преподаватель одобряет
    dec_res = client.post("/api/applications/decide", json={
        "application_id": app_id,
        "decision": "APPROVE"
    }, headers=headers_teacher)
    assert dec_res.status_code == 200
    assert dec_res.json()["status"] == "APPROVED"

def test_wrong_teacher_cannot_approve():
    """Тест 15: преподаватель не может принимать решение по чужой теме (403)"""
    from main import SessionLocal, User, hash_password
    other_teacher = f"teacher_{uuid.uuid4().hex[:6]}@test.com"
    _db = SessionLocal()
    try:
        _t = User(
            full_name="Чужой Преподаватель",
            email=other_teacher,
            password_hash=hash_password("123456"),
            role="teacher",
            department="ВТиПО",
            is_active=True
        )
        _db.add(_t)
        _db.commit()
    finally:
        _db.close()
    other_token = get_auth_token(other_teacher)

    # Тема 1 принадлежит Доц. Ахметову
    st_email = f"wrong_st_{uuid.uuid4().hex[:6]}@test.com"
    client.post("/api/register", json={"full_name": "Студент Чужого Теста", "email": st_email, "password": "123456", "role": "student"})
    st_token = get_auth_token(st_email)
    app_res = client.post("/api/applications/apply", json={"topic_id": 1, "priority": 1}, headers={"Authorization": f"Bearer {st_token}"})
    app_id = app_res.json()["application_id"]

    res = client.post("/api/applications/decide", json={
        "application_id": app_id,
        "decision": "APPROVE"
    }, headers={"Authorization": f"Bearer {other_token}"})
    assert res.status_code == 403
    assert "только по своим темам" in res.text

def test_reject_requires_reason():
    """Тест 16: отклонение заявки требует обязательное указание причины (400)"""
    teacher_token = get_auth_token("teacher@test.com")

    st_email = f"reject_st_{uuid.uuid4().hex[:6]}@test.com"
    client.post("/api/register", json={"full_name": "Отклоняемый Студент", "email": st_email, "password": "123456", "role": "student"})
    st_token = get_auth_token(st_email)
    app_res = client.post("/api/applications/apply", json={"topic_id": 1, "priority": 1}, headers={"Authorization": f"Bearer {st_token}"})
    app_id = app_res.json()["application_id"]

    res = client.post("/api/applications/decide", json={
        "application_id": app_id,
        "decision": "REJECT",
        "reason": ""  # Пустая причина
    }, headers={"Authorization": f"Bearer {teacher_token}"})
    assert res.status_code == 400
    assert "причину отказа" in res.text

# ─── 6. ANTI-DUPLICATE ────────────────────────────────────────────────────────
def test_duplicate_topic_under_threshold():
    """Тест 17: уникальная тема имеет показатель сходства ниже 75%"""
    res = client.post("/api/topics/check-duplicate", json={"title": "Квантовое моделирование астрофизических гравитационных волн"})
    assert res.status_code == 200
    data = res.json()
    assert data["is_duplicate"] is False
    assert data["similarity"] < 75.0

def test_duplicate_topic_above_threshold():
    """Тест 18: тема, схожая с существующей, определяется как дубликат (>= 75%)"""
    sample = "Разработка веб-платформы автоматизации распределения дипломных работ"
    res = client.post("/api/topics/check-duplicate", json={"title": sample})
    assert res.status_code == 200
    data = res.json()
    assert data["is_duplicate"] is True
    assert data["similarity"] >= 75.0

def test_anti_duplicate_check():
    """Тест 18 (алиас): проверка работы алгоритма антидубликата"""
    test_duplicate_topic_under_threshold()
    test_duplicate_topic_above_threshold()

