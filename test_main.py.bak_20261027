    assert response.status_code == 401

def test_session_required():
    """Тест 4: защищенные эндпоинты требуют валидный session токен (401)"""
    # Без токена
    res1 = client.get("/api/admin/backup")
    assert res1.status_code == 401

    # С недействительным токеном
    res2 = client.get("/api/admin/backup", headers={"Authorization": "Bearer invalid_token_xyz"})
    assert res2.status_code == 401

