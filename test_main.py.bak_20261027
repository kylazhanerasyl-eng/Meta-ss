# ─── 13. OFFICIAL ORDER, PDF, QR & VERIFICATION REGRESSION TESTS ──────────────
def test_pdf_unicode_fonts_and_kazakh_letters():
    """Тест: PDF использует Unicode TTF шрифты, кириллица и казахские буквы не используют Helvetica"""
    head_token = get_auth_token("head@test.com")
    res = client.get("/api/export/pdf-order", headers={"Authorization": f"Bearer {head_token}"})
    assert res.status_code == 200
    assert "application/pdf" in res.headers.get("content-type", "")
    assert res.content[:4] == b"%PDF"
    # Helvetica must not be used for text rendering
    assert b"Helvetica" not in res.content
    # Unicode TrueType fonts (ArialMT / Arial-BoldMT) are embedded
    assert b"ArialMT" in res.content or b"Arial-BoldMT" in res.content

def test_order_unique_verification_code():
    """Тест: каждый OfficialOrder получает уникальный verification_code"""
    from main import SessionLocal, OfficialOrder, generate_order_verification_code
    db = SessionLocal()
    code1 = generate_order_verification_code()
    code2 = generate_order_verification_code()
    assert code1 != code2
    assert code1.startswith("ORDER-2026-")
    assert code2.startswith("ORDER-2026-")

    ord1 = OfficialOrder(order_number=f"TEST-ORD-{uuid.uuid4().hex[:6]}", document_hash="hash1")
    ord2 = OfficialOrder(order_number=f"TEST-ORD-{uuid.uuid4().hex[:6]}", document_hash="hash2")
    db.add(ord1)
    db.add(ord2)
    db.commit()
    try:
        assert ord1.verification_code != ord2.verification_code
        assert ord1.verification_code.startswith("ORDER-2026-")
        assert ord2.verification_code.startswith("ORDER-2026-")
    finally:
        db.delete(ord1)
        db.delete(ord2)
        db.commit()
        db.close()

def test_pdf_qr_target_current_order():
    """Тест: QR-код ведёт именно на /verify/{verification_code} текущего приказа и использует BASE_URL"""
    import qrcode
    from main import SessionLocal, OfficialOrder, BASE_URL
    db = SessionLocal()
    order = db.query(OfficialOrder).first()
    assert order is not None
    expected_url = f"{BASE_URL}/verify/{order.verification_code}"
    db.close()

    qr = qrcode.QRCode()
    qr.add_data(expected_url)
    qr.make(fit=True)
    assert any(expected_url.encode() in d.data for d in qr.data_list)

def test_pdf_saved_to_disk_and_document_hash():
    """Тест: финальный PDF сохранён на диск, document_hash = 64 hex, calculated SHA256 == stored hash"""
    import os, hashlib
    from main import SessionLocal, OfficialOrder, ORDERS_DIR
    head_token = get_auth_token("head@test.com")
    res = client.get("/api/export/pdf-order", headers={"Authorization": f"Bearer {head_token}"})
    assert res.status_code == 200

    db = SessionLocal()
    order = db.query(OfficialOrder).first()
    assert order is not None
    order_code = order.verification_code
    stored_hash = order.document_hash
    db.close()

    # Hash must be 64 hexadecimal characters
    assert len(stored_hash) == 64
    assert all(c in "0123456789abcdef" for c in stored_hash.lower())

    # File must exist on disk
    pdf_path = os.path.join(ORDERS_DIR, f"order_{order_code}.pdf")
    assert os.path.exists(pdf_path)

    with open(pdf_path, "rb") as f:
        disk_bytes = f.read()

    calculated_disk_hash = hashlib.sha256(disk_bytes).hexdigest()
    assert calculated_disk_hash == stored_hash
    assert hashlib.sha256(res.content).hexdigest() == stored_hash

def test_repeated_pdf_download_returns_same_file():
    """Тест: повторное скачивание этого приказа отдаёт тот же файл байт в байт"""
    import hashlib
    head_token = get_auth_token("head@test.com")
    headers = {"Authorization": f"Bearer {head_token}"}
    res1 = client.get("/api/export/pdf-order", headers=headers)
    res2 = client.get("/api/export/pdf-order", headers=headers)
    assert res1.status_code == 200
    assert res2.status_code == 200
    assert res1.content == res2.content
    h1 = hashlib.sha256(res1.content).hexdigest()
    h2 = hashlib.sha256(res2.content).hexdigest()
    assert h1 == h2
    assert len(h1) == 64

def test_verification_page_shows_real_hash_and_honest_wording():
    """Тест: Verification page показывает реальный 64-hex hash, честную формулировку META, убрано «ЭЦП верифицирована»"""
    from main import SessionLocal, OfficialOrder
    db = SessionLocal()
    order = db.query(OfficialOrder).first()
    assert order is not None
    order_code = order.verification_code
    stored_hash = order.document_hash
    db.close()

    res = client.get(f"/verify/{order_code}")
    assert res.status_code == 200
    # Честные формулировки
    assert "Документ зарегистрирован в реестре META" in res.text
    assert "Контрольная сумма SHA-256" in res.text
    # Реальный 64-hex hash отображается полностью
    assert stored_hash in res.text
    # Убраны слова «ЭЦП верифицирована» и «Статус ЭЦП»
    assert "ЭЦП верифицирована" not in res.text
    assert "Статус ЭЦП" not in res.text
    assert "Действительна (Криптографически заверено)" not in res.text

    # Несуществующий приказ
    res_unknown = client.get("/verify/ORDER-NON-EXISTENT-999")
    assert res_unknown.status_code == 200
    assert "Документ не найден в реестре • Цифровой реестр ASTRA" in res_unknown.text

# ─── 14. BACKEND HARDENING & INTEGRITY REGRESSION TESTS ──────────────────────────
def test_norm_control_none_styles_warning():
    """Тест: Norm-control НЕ считает None font/size/spacing автоматически PASS (отмечает UNKNOWN/WARNING)"""
    import docx
    doc = docx.Document()
    doc.add_paragraph("Тестовый фрагмент диплома без явного оформления шрифта")
    buf = BytesIO()
    doc.save(buf)
    buf.seek(0)

    res = client.post(
        "/api/norm-control/check-docx",
        files={"file": ("raw_document.docx", buf, "application/vnd.openxmlformats-officedocument.wordprocessingml.document")}
    )
    assert res.status_code == 200
    data = res.json()
    assert "checks" in data

    font_check = next((c for c in data["checks"] if "Гарнитура" in c["title"] or "шрифт" in c["title"].lower()), None)
    size_check = next((c for c in data["checks"] if "Размер" in c["title"] or "кегль" in c["title"].lower()), None)
    spacing_check = next((c for c in data["checks"] if "интервал" in c["title"].lower()), None)

    assert font_check is not None
    assert font_check["passed"] is False
    assert font_check.get("status") in ["UNKNOWN", "WARNING"]

    assert size_check is not None
    assert size_check["passed"] is False
    assert size_check.get("status") in ["UNKNOWN", "WARNING"]

    assert spacing_check is not None
    assert spacing_check["passed"] is False
    assert spacing_check.get("status") in ["UNKNOWN", "WARNING"]


def test_norm_control_inherited_normal_style_pass():
    """Тест: Norm-control корректно распознает унаследованные стили Normal (TNR, 14pt, 1.5)"""
    import docx
    doc = docx.Document()
    normal_style = doc.styles["Normal"]
    normal_style.font.name = "Times New Roman"
    normal_style.font.size = docx.shared.Pt(14)
    normal_style.paragraph_format.line_spacing = 1.5

    doc.add_paragraph("Введение к исследованию")
    doc.add_paragraph("Основной раздел дипломного проектирования")
    doc.add_paragraph("Заключение")
    doc.add_paragraph("Список использованных источников")

    buf = BytesIO()
    doc.save(buf)
    buf.seek(0)

    res = client.post(
        "/api/norm-control/check-docx",
        files={"file": ("styled_document.docx", buf, "application/vnd.openxmlformats-officedocument.wordprocessingml.document")}
    )
    assert res.status_code == 200
    data = res.json()

    font_check = next((c for c in data["checks"] if "Гарнитура" in c["title"] or "Times New Roman" in c["title"]), None)
    size_check = next((c for c in data["checks"] if "14 пт" in c["title"]), None)
    spacing_check = next((c for c in data["checks"] if "1.5" in c["title"]), None)

    assert font_check is not None and font_check["passed"] is True
    assert size_check is not None and size_check["passed"] is True
    assert spacing_check is not None and spacing_check["passed"] is True


def test_upload_security_disallowed_extension():
    """Тест: upload отклоняет недопустимые расширения файлов"""
    fake_exe = BytesIO(b"MZ executable content")
    res = client.post(
        "/api/checkpoints/upload",
        data={"checkpoint_id": 1},
        files={"file": ("malicious.exe", fake_exe, "application/octet-stream")},
        headers={"Authorization": f"Bearer {get_auth_token('student@test.com')}"}
    )
    assert res.status_code == 400
    assert "Недопустимый формат" in res.text


def test_upload_security_max_size_limit():
    """Тест: upload отклоняет файлы превышающие лимит размера (413 Payload Too Large)"""
    big_data = BytesIO(b"A" * (16 * 1024 * 1024))
    res = client.post(
        "/api/norm-control/check-docx",
        files={"file": ("oversized.docx", big_data, "application/vnd.openxmlformats-officedocument.wordprocessingml.document")}
    )
    assert res.status_code == 413
    assert "превышает допустимый лимит" in res.text


def test_active_sqlite_db_backup_path():
    """Тест: backup использует реальный путь активной SQLite DB через get_active_sqlite_db_path()"""
    import os
    from main import get_active_sqlite_db_path, engine
    active_path = get_active_sqlite_db_path()
    assert os.path.isabs(active_path)
    assert os.path.exists(active_path)
    if getattr(engine.url, "database", None):
        assert os.path.normpath(active_path) == os.path.normpath(os.path.abspath(engine.url.database))

    head_token = get_auth_token("head@test.com")
    backup_res = client.get("/api/admin/backup", headers={"Authorization": f"Bearer {head_token}"})
    assert backup_res.status_code == 200
    assert len(backup_res.content) > 1000


def test_serve_uploaded_file_path_traversal():
    """Тест: предотвращение path traversal при отдаче файлов из uploads"""
    headers = {"Authorization": f"Bearer {get_auth_token('student@test.com')}"}
    res1 = client.get("/uploads/..%2Fmain.py", headers=headers)
    assert res1.status_code in [400, 403, 404]

    res2 = client.get("/uploads/..\\main.py", headers=headers)
    assert res2.status_code in [400, 403, 404]



