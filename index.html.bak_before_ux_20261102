                                <svg class="w-3.5 h-3.5 ${bulletColor} flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
                                <span>Требования этапа:</span>
                            </div>
                            <ul class="space-y-1 text-[13px] ${textColor} leading-snug">
                                ${list.map(item => `<li class="flex items-start gap-1.5"><span class="${bulletColor} font-bold select-none">•</span><span>${escapeHtml(item)}</span></li>`).join('')}
                            </ul>
                        </div>
                    `;
                }

                grid.innerHTML = cps.map((c, idx) => {
                    const isAccepted = c.status === 'ACCEPTED';
                    const isUnderReview = c.status === 'UNDER_REVIEW';
                    const isRevision = c.status === 'REVISION';
                    
                    let isCompleted = false;
                    let isCurrent = false;
                    let isFuture = false;
                    let priorStage = idx > 0 ? (cps[idx - 1].stage || 25) : 25;

                    if (isAccepted) {
                        isCompleted = true;
                    } else if (!hasUnfinishedPrior) {
                        isCurrent = true;
                        hasUnfinishedPrior = true;
                    } else {
                        isFuture = true;
                    }

                    // Чистый заголовок карточки без повтора процентов
                    const cleanTitle = (c.title || '').replace(/^\d+%\s*[-—–:]\s*/i, '').trim();

                    // Человекочитаемое имя файла
                    let displayFileName = c.file_name || '';
                    if (displayFileName && (displayFileName.startsWith('cp_') || displayFileName.length > 28)) {
                        displayFileName = `Отчет_Этап_${c.stage}.pdf`;
                    }

                    // 1. ЗАВЕРШЕННЫЙ ЭТАП (Принято)
                    if (isCompleted) {
                        return `
                            <div class="p-5 rounded-2xl bg-[#FFFFFF] dark:bg-[#111A2E] border border-emerald-500/30 dark:border-emerald-500/20 shadow-xs flex flex-col justify-between transition">
                                <div>
                                    <div class="flex items-center justify-between gap-2 mb-3">
                                        <span class="text-xs font-bold px-2.5 py-0.5 rounded-lg bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
                                            Этап ${c.stage}%
                                        </span>
                                        <span class="px-2 py-0.5 rounded-md text-[11px] font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 flex items-center gap-1">
                                            <span>✓</span> Принято
                                        </span>
                                    </div>
                                    <h4 class="font-bold text-sm text-[#0F1B33] dark:text-[#EAF0FB] mb-1.5 leading-snug">${escapeHtml(cleanTitle)}</h4>
                                    <div class="text-[11px] font-medium text-[#4A5873] dark:text-[#9FB0CC] flex items-center gap-1 mb-2.5">
                                        <span>Срок сдачи:</span> <b class="text-[#0F1B33] dark:text-[#EAF0FB]">${escapeHtml(c.deadline)}</b>
                                    </div>

                                    ${c.review_comment ? `
                                        <div class="p-2.5 rounded-xl text-xs mb-3 font-medium bg-emerald-50 dark:bg-emerald-950/30 text-emerald-800 dark:text-emerald-200 border border-emerald-200 dark:border-emerald-900/40">
                                            <div class="text-[10px] font-bold uppercase tracking-wide mb-0.5">Отзыв руководителя:</div>
                                            <div class="text-xs leading-relaxed">«${escapeHtml(c.review_comment)}»</div>
                                        </div>
                                    ` : renderStageRequirements(c.stage, false)}

                                    ${c.file_name ? `
                                        <div class="mb-3 text-[11px] text-[#4A5873] dark:text-[#9FB0CC] flex items-center gap-1.5 truncate">
                                            <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                                            <span class="font-medium truncate" title="${escapeHtml(c.file_name)}">${escapeHtml(displayFileName)}</span>
                                        </div>
                                    ` : ''}
                                </div>

                                <div class="pt-3 border-t border-[#DCE2EE] dark:border-[#24324F] flex items-center gap-2">
                                    <a href="#" data-download-url="${escapeHtml(c.download_url)}" data-download-name="${escapeHtml(c.file_name || 'report')}" onclick="return downloadAuthenticatedFile(event, this.dataset.downloadUrl, this.dataset.downloadName)" class="flex-1 py-1.5 rounded-xl text-[11px] font-semibold text-center text-[#2447B8] dark:text-[#9DB4E6] bg-[#E6ECFB] dark:bg-[#2447B8]/20 hover:bg-[#E6ECFB]/80 transition flex items-center justify-center gap-1 border border-[#9DB4E6]/40 dark:border-[#9DB4E6]/20">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                                        <span>Скачать</span>
                                    </a>
                                    <button data-checkpoint-id="${c.id}" data-history-title="${escapeHtml(cleanTitle)}" onclick="openCheckpointHistory(this.dataset.checkpointId, this.dataset.historyTitle)" class="py-1.5 px-3 rounded-xl text-[11px] font-medium text-[#0F1B33] dark:text-[#EAF0FB] bg-[#F4F6FA] dark:bg-[#0B1220] hover:bg-[#E6ECFB] dark:hover:bg-[#24324F] border border-[#DCE2EE] dark:border-[#24324F] transition cursor-pointer flex items-center gap-1">
                                        История
                                    </button>
                                </div>
                            </div>
                        `;
                    }

                    // 2. ТЕКУЩИЙ АКТИВНЫЙ ЭТАП (Главный фокус экрана - без лишнего бейджа 'ТЕКУЩИЙ')
                    if (isCurrent) {
                        let statusBadgeHtml = '';
                        if (isUnderReview) {
                            statusBadgeHtml = `<span class="px-2 py-0.5 rounded-md text-[11px] font-semibold bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300">На проверке</span>`;
                        } else if (isRevision) {
                            statusBadgeHtml = `<span class="px-2 py-0.5 rounded-md text-[11px] font-semibold bg-rose-100 text-rose-800 dark:bg-rose-950/60 dark:text-rose-300">На доработке</span>`;
                        } else {
                            statusBadgeHtml = `<span class="px-2 py-0.5 rounded-md text-[11px] font-semibold bg-purple-100 text-purple-800 dark:bg-purple-950/60 dark:text-purple-300">В работе</span>`;
                        }

                        return `
                            <div class="p-5 rounded-2xl bg-[#FFFFFF] dark:bg-[#111A2E] border-2 shadow-lg flex flex-col justify-between relative transition" style="border-color: rgba(168, 85, 247, 0.55); box-shadow: 0 0 25px rgba(139, 92, 246, 0.16);">
                                <div>
                                    <div class="flex items-center justify-between gap-2 mb-3">
                                        <span class="text-xs font-bold px-2.5 py-0.5 rounded-lg bg-gradient-to-r from-[#2447B8] to-[#2447B8] text-white shadow-xs">
                                            Этап ${c.stage}%
                                        </span>
                                        ${statusBadgeHtml}
                                    </div>
                                    <h4 class="font-bold text-sm text-[#0F1B33] dark:text-[#EAF0FB] mb-1.5 leading-snug">${escapeHtml(cleanTitle)}</h4>
                                    <div class="text-[11px] font-medium text-[#4A5873] dark:text-[#9FB0CC] flex items-center gap-1 mb-2.5">
                                        <span>Срок сдачи:</span> <b class="text-[#2447B8] dark:text-[#3B6CF0] font-bold">${escapeHtml(c.deadline)}</b>
                                    </div>

                                    ${c.review_comment ? `
                                        <div class="p-2.5 rounded-xl text-xs mb-3 font-medium ${
                                            isRevision ? 'bg-rose-50 dark:bg-rose-950/40 text-rose-800 dark:text-rose-200 border border-rose-200 dark:border-rose-900/60' : 'bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-200 border border-emerald-200 dark:border-emerald-900/60'
                                        }">
                                            <div class="text-[10px] font-bold uppercase tracking-wide mb-0.5">${isRevision ? 'Замечание руководителя:' : 'Отзыв руководителя:'}</div>
                                            <div class="text-xs leading-relaxed">«${escapeHtml(c.review_comment)}»</div>
                                        </div>
                                    ` : renderStageRequirements(c.stage, false)}

                                    ${c.file_name ? `
                                        <div class="mb-3 text-[11px] text-[#4A5873] dark:text-[#9FB0CC] flex items-center gap-1.5 truncate">
                                            <svg class="w-3.5 h-3.5 text-[#2447B8] dark:text-[#3B6CF0] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>
                                            <span class="font-medium truncate" title="${escapeHtml(c.file_name)}">${escapeHtml(displayFileName)}</span>
                                        </div>
                                    ` : ''}
                                </div>

                                <div class="pt-3 border-t border-[#DCE2EE] dark:border-[#24324F] flex flex-col gap-2">
                                    <label class="w-full py-2.5 rounded-xl text-xs font-semibold text-center cursor-pointer text-white transition flex items-center justify-center gap-2 shadow-md hover:brightness-105 active:scale-[0.99]" style="background: linear-gradient(135deg, #2447B8 0%, #2447B8 100%); box-shadow: 0 4px 16px rgba(109, 93, 252, 0.35);">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                                        <span>${c.file_name ? 'Обновить отчет' : 'Загрузить отчет'}</span>
                                        <input type="file" class="hidden" accept=".docx,.pdf,.doc,.zip,.rar" onchange="uploadCheckpointFile(this, ${c.id})">
                                    </label>
                                    ${c.file_name ? `
                                        <div class="flex items-center gap-2">
                                            ${c.download_url ? `<a href="#" data-url="${escapeHtml(c.download_url)}" data-name="${escapeHtml(c.file_name || 'report')}" onclick="return downloadAuthenticatedFile(event, this.dataset.url, this.dataset.name)" class="flex-1 py-1.5 rounded-xl text-[11px] font-semibold text-center text-[#2447B8] dark:text-[#3B6CF0] bg-[#E6ECFB] dark:bg-purple-950/40 hover:bg-[#DFDBF5] transition flex items-center justify-center gap-1 border border-purple-300/40 dark:border-rose-500/20">Скачать</a>` : ''}
                                            <button data-checkpoint-id="${c.id}" data-history-title="${escapeHtml(cleanTitle)}" onclick="openCheckpointHistory(this.dataset.checkpointId, this.dataset.historyTitle)" class="py-1.5 px-3 rounded-xl text-[11px] font-medium text-[#0F1B33] dark:text-[#EAF0FB] bg-[#F4F6FA] dark:bg-[#0B1220] hover:bg-[#E6ECFB] border border-[#DCE2EE] dark:border-[#24324F] transition cursor-pointer">
                                                История
                                            </button>
                                        </div>
                                    ` : ''}
                                </div>
                            </div>
                        `;
                    }

                    // 3. БУДУЩИЕ ЭТАПЫ (Ожидают - с блоком 'Требования этапа')
                    return `
                        <div class="p-5 rounded-2xl bg-[#FFFFFF]/60 dark:bg-[#111A2E]/60 border border-[#DCE2EE]/70 dark:border-[#24324F]/70 shadow-none flex flex-col justify-between opacity-65 transition">
                            <div>
                                <div class="flex items-center justify-between gap-2 mb-3">
                                    <span class="text-xs font-semibold px-2.5 py-0.5 rounded-lg bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400">
                                        Этап ${c.stage}%
                                    </span>
                                    <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400">
                                        Ожидает
                                    </span>
                                </div>
                                <h4 class="font-bold text-sm text-[#0F1B33]/80 dark:text-[#EAF0FB]/80 mb-1.5 leading-snug">${escapeHtml(cleanTitle)}</h4>
                                <div class="text-[11px] font-medium text-[#4A5873]/70 dark:text-[#9FB0CC]/70 flex items-center gap-1 mb-2.5">
                                    <span>Срок сдачи:</span> <span>${escapeHtml(c.deadline)}</span>
                                </div>

                                ${renderStageRequirements(c.stage, true)}
                            </div>

                            <div class="pt-3 border-t border-[#DCE2EE]/60 dark:border-[#24324F]/60">
                                <div class="w-full py-2.5 rounded-xl text-xs font-medium text-center bg-slate-100/80 dark:bg-slate-800/40 text-slate-400 dark:text-slate-500 border border-slate-200/60 dark:border-slate-700/40 flex items-center justify-center gap-1.5 cursor-not-allowed select-none">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                                    <span>Доступно после сдачи ${priorStage}%</span>
                                </div>
                            </div>
                        </div>
                    `;
                }).join('');
            } catch (e) {
                console.warn('Checkpoints fetch error:', e);
            }
        }

        async function uploadCheckpointFile(inputEl, checkpointId) {
            if (!inputEl.files || inputEl.files.length === 0) return;
            const file = inputEl.files[0];
            const formData = new FormData();
            formData.append('checkpoint_id', checkpointId);
            formData.append('file', file);

            inputEl.disabled = true;
            const labelEl = inputEl.parentElement;
            if (labelEl) labelEl.classList.add('opacity-50', 'pointer-events-none');
            showToast('Загрузка отчета...', file.name, 'info');

            try {
                const res = await apiFetch('/api/checkpoints/upload', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if (res.ok) {
                    showToast('Успешно загружено!', `Версия ${data.version || 1} передана на проверку`, 'success');
                    loadStudentCheckpoints();
                    loadStudentActivityFeed();
                } else {
                    showToast('Ошибка загрузки', data.detail || 'Не удалось загрузить файл', 'error');
                }
            } catch (e) {
                showToast('Ошибка сети', 'Сбой при передаче файла', 'error');
            } finally {
                inputEl.disabled = false;
                inputEl.value = '';
                if (labelEl) labelEl.classList.remove('opacity-50', 'pointer-events-none');
            }
        }

        async function openCheckpointHistory(checkpointId, title) {
            const modal = document.getElementById('checkpointHistoryModal');
            const list = document.getElementById('historyModalList');
            const titleEl = document.getElementById('historyModalTitle');
            if (!modal) return;

            titleEl.textContent = `История версий: ${title}`;
            list.innerHTML = '<div class="text-slate-400 py-3 text-center">Загрузка истории...</div>';
            notifyModalOpen(modal);

            try {
                const res = await apiFetch(`/api/checkpoints/${checkpointId}/history`);
                const history = await res.json();

                if (!history || history.length === 0) {
                    list.innerHTML = '<div class="text-slate-400 py-4 text-center">Загруженных версий пока нет</div>';
                    return;
                }

                list.innerHTML = history.map(h => `
                    <div class="p-3 bg-slate-50 dark:bg-slate-800/80 rounded-lg border border-slate-200 dark:border-slate-700">
                        <div class="flex items-center justify-between mb-1">
                            <span class="font-semibold text-[#2447B8] dark:text-[#9DB4E6]">Версия v${escapeHtml(h.version)}</span>
                            <span class="text-[10px] text-slate-500">${escapeHtml(h.submitted_at)}</span>
                        </div>
                        <div class="font-medium text-slate-900 dark:text-white truncate flex items-center gap-1.5">
                            <svg class="w-3.5 h-3.5 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>
                            <span class="truncate">${escapeHtml(h.file_name)}</span>
                        </div>
                        <div class="mt-2 flex items-center justify-between text-[11px]">
                            <span class="px-2 py-0.5 rounded-md text-[10px] font-semibold ${h.status === 'ACCEPTED' ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300' : (h.status === 'REVISION' ? 'bg-red-100 text-red-800 dark:bg-red-950/60 dark:text-red-300' : 'bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300')}">${escapeHtml(h.status === 'ACCEPTED' ? 'Принято' : (h.status === 'REVISION' ? 'На доработке' : 'На проверке'))}</span>
                            ${h.review_comment ? `<span class="italic text-slate-500 truncate max-w-xs" title="${escapeHtml(h.review_comment)}">«${escapeHtml(h.review_comment)}»</span>` : ''}
                        </div>
                    </div>
                `).join('');
            } catch (e) {
                list.innerHTML = '<div class="text-rose-500 py-3 text-center">Ошибка загрузки истории</div>';
            }
        }

        function closeHistoryModal() {
            const modal = document.getElementById('checkpointHistoryModal');
            notifyModalClose(modal);
        }

        async function loadStudentActivityFeed() {
            if (!currentUser || currentUser.role !== 'student') return;
            const list = document.getElementById('studentActivityList');
            if (!list) return;

            try {
                const res = await apiFetch('/api/notifications');
                if (!res.ok) {
                    list.innerHTML = '<div class="text-[#4A5873] dark:text-[#9FB0CC] py-4 text-center">Не удалось загрузить историю</div>';
                    return;
                }
                const notifs = await res.json();

                if (!notifs || !Array.isArray(notifs) || notifs.length === 0) {
                    list.innerHTML = '<div class="text-[#4A5873] dark:text-[#9FB0CC] py-4 text-center">Событий пока нет</div>';
                    const subEl = document.getElementById('activityFeedSub');
                    if (subEl) subEl.textContent = `${tr('activityFeedSub', 'Показаны последние события')} (0)`;
                    return;
                }

                // Дедупликация ТОЛЬКО одинаковых повторов с идентичным id или текстом
                const seenKeys = new Set();
                const cleanNotifs = [];
                for (const n of notifs) {
                    const key = n.id != null ? `id_${n.id}` : `${n.title}_${n.message}_${n.created_at}`;
                    if (!seenKeys.has(key)) {
                        seenKeys.add(key);
                        cleanNotifs.push(n);
                    }
                }

                // Сортировка по настоящей дате события (свежие сверху)
                cleanNotifs.sort((a, b) => {
                    const da = a.created_at ? new Date(a.created_at).getTime() : 0;
                    const db = b.created_at ? new Date(b.created_at).getTime() : 0;
                    return db - da;
                });

                const displayedNotifs = cleanNotifs.slice(0, 10);
                const subEl = document.getElementById('activityFeedSub');
                if (subEl) subEl.textContent = `${tr('activityFeedSub', 'Показаны последние события')} (${displayedNotifs.length})`;

                list.innerHTML = displayedNotifs.map(n => {
                    const msg = n.message || '';
                    const rawTitle = n.title || '';
                    const title = rawTitle.replace(/[\u{1F300}-\u{1F9FF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}🎉★✏️✓ℹ️⚡🔔]+/gu, '').trim();

                    let iconSvg = '';
                    let badgeHtml = '';
                    let displayComment = msg;

                    if (msg.includes('ACCEPTED') || title.includes('Принято') || n.type === 'success') {
                        iconSvg = `<div class="w-7 h-7 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center flex-shrink-0 font-bold text-xs mt-0.5">✓</div>`;
                        badgeHtml = `<span class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300">Принято</span>`;
                        if (msg.includes('Комментарий руководителя:')) {
                            const parts = msg.split('Комментарий руководителя:');
                            displayComment = parts[1].trim();
                        }
                    } else if (msg.includes('REVISION') || title.includes('доработк') || n.type === 'warning') {
                        iconSvg = `<div class="w-7 h-7 rounded-full bg-amber-100 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center flex-shrink-0 font-bold text-xs mt-0.5">✏️</div>`;
                        badgeHtml = `<span class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300">На доработку</span>`;
                        if (msg.includes('Замечания руководителя:')) {
                            const parts = msg.split('Замечания руководителя:');
                            displayComment = parts[1].trim();
                        }
                    } else {
                        iconSvg = `<div class="w-7 h-7 rounded-full bg-purple-100 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400 flex items-center justify-center flex-shrink-0 font-bold text-xs mt-0.5">ℹ️</div>`;
                        badgeHtml = `<span class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-[#E6ECFB] text-[#2447B8] dark:bg-purple-950/60 dark:text-purple-300">Инфо</span>`;
                    }

                    let timeFormatted = n.created_at || '';
                    if (timeFormatted.includes('T')) {
                        try {
                            const d = new Date(timeFormatted);
                            timeFormatted = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                        } catch (e) {}
                    }

                    return `
                        <div class="flex items-start gap-3 p-3 rounded-xl bg-[#FFFFFF] dark:bg-[#111A2E] border border-[#DCE2EE] dark:border-[#24324F] shadow-xs hover:border-[#2447B8]/40 transition">
                            ${iconSvg}
                            <div class="flex-grow min-w-0">
                                <div class="flex items-center justify-between gap-2 mb-1">
