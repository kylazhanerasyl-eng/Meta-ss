        async function submitRejectApplication() {
            const appId = document.getElementById('rejectAppId')?.value;
            const reason = document.getElementById('rejectReasonInput')?.value?.trim();
            const btn = document.getElementById('submitRejectBtn');
            if (!reason) {
                showToast('Ошибка', 'Обязательно укажите причину отклонения заявки', 'error');
