        async function submitCompanyTopic(ev) {
            ev.preventDefault();
            const btn = document.getElementById('coSubmitBtn');
            const val = id => document.getElementById(id).value.trim();
            const payload = {
                company_id: currentUser.id,
                title: val('coTopicTitle'),
                supervisor_name: val('coContact'),
                tags: val('coTags') || 'Industry',
                required_skills: val('coSkills') || 'Git',
                difficulty: parseInt(val('coDifficulty'), 10),
                quota_total: parseInt(val('coQuota'), 10),
                has_data: document.getElementById('coHasData').checked
            };
            btn.disabled = true;
            try {
                const res = await apiFetch('/api/company/topics', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload)
                });
                const data = await res.json().catch(() => ({}));
                if (res.ok) {
                    showToast(tr('coPublished', 'Тема опубликована'), data.message || '', 'success');
                    document.getElementById('coForm').reset();
                    loadCompanyDashboard();
                } else {
                    showToast(tr('coPublishError', 'Тему не удалось опубликовать'), typeof data.detail === 'string' ? data.detail : tr('coCheckFields', 'Проверьте поля формы и повторите.'), 'error');
                }
            } catch (e) {
                showToast(tr('coPublishError', 'Тему не удалось опубликовать'), tr('coNetworkHint', 'Нет связи с сервером. Повторите позже.'), 'error');
            } finally {
                btn.disabled = false;
            }
        }

        async function loadTeacherDashboard() {
            if (!currentUser || currentUser.role !== 'teacher') return;
            const nameHdr = document.getElementById('teacherNameHeader');
            if (nameHdr) nameHdr.textContent = currentUser.full_name;

            try {
                // 1. Заявки на темы преподавателя (реальные данные из API)
                const appsRes = await apiFetch('/api/applications');
                const allApps = appsRes.ok ? await appsRes.json() : [];
                
                // Фильтруем заявки, адресованные данному преподавателю
                const myApps = Array.isArray(allApps) ? allApps.filter(a => 
                    a.supervisor_name && (a.supervisor_name.includes(currentUser.full_name) || a.supervisor_name.includes(currentUser.full_name.split(' ')[0]))
                ) : [];

                const countBadge = document.getElementById('teacherAppsCountBadge');
                const tbody = document.getElementById('teacherApplicationsTable');
                if (tbody) {
                    const rawPending = myApps.filter(a => a.status === 'SUBMITTED');
                    const seenIds = new Set();
                    const pendingApps = [];
                    for (const a of rawPending) {
                        if (a && a.id != null) {
                            if (!seenIds.has(a.id)) {
                                seenIds.add(a.id);
                                pendingApps.push(a);
                            }
                        }
                    }
                    if (countBadge) countBadge.textContent = pendingApps.length;
                    if (pendingApps.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="6" class="py-6 text-center text-[#4A5873] dark:text-[#9FB0CC]">Новых заявок пока нет</td></tr>';
                    } else {
                        tbody.innerHTML = pendingApps.map(a => `
                            <tr class="hover:bg-[#EEF1F8]/60 dark:hover:bg-[#0F1830]/40 transition">
                                <td class="py-2.5 px-3 font-semibold text-[#0F1B33] dark:text-[#EAF0FB]">${escapeHtml(a.student_name || 'Студент')}</td>
                                <td class="py-2.5 px-3 font-bold text-[#2447B8] dark:text-[#9DB4E6]">${escapeHtml(a.student_gpa != null ? a.student_gpa : (a.student_rating != null ? a.student_rating : '—'))}</td>
                                <td class="py-2.5 px-3 font-medium text-[#0F1B33] dark:text-[#EAF0FB] max-w-xs truncate" title="${escapeHtml(a.topic_title || '—')}">${escapeHtml(a.topic_title || '—')}</td>
                                <td class="py-2.5 px-3">
                                    <span class="px-2 py-0.5 rounded-md text-[11px] font-semibold bg-[#EEF1F8] dark:bg-[#0F1830] text-[#4A5873] dark:text-[#9FB0CC] border border-[#DCE2EE] dark:border-[#24324F]">
                                        № ${escapeHtml(a.priority != null ? a.priority : '1')}
                                    </span>
                                </td>
                                <td class="py-2.5 px-3">
                                    <span class="px-2 py-0.5 rounded-md text-[11px] font-semibold bg-amber-50 text-amber-700 dark:bg-amber-950/60 dark:text-amber-300 border border-amber-200 dark:border-amber-800">
                                        На рассмотрении
                                    </span>
                                </td>
                                <td class="py-2.5 px-3 text-right">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <button onclick="decideApplication(${a.id}, 'APPROVE')" class="bg-[#2447B8] hover:bg-[#1B3794] text-white px-3 py-1.5 rounded-xl font-semibold text-xs cursor-pointer shadow-sm transition">
                                            Одобрить
                                        </button>
                                        <button onclick="openRejectReasonModal(${a.id})" class="bg-[#EEF1F8] hover:bg-red-50 text-red-700 dark:bg-[#0F1830] dark:hover:bg-red-950/40 dark:text-red-400 border border-[#DCE2EE] dark:border-[#24324F] px-3 py-1.5 rounded-xl font-semibold text-xs cursor-pointer transition">
                                            Отклонить
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        `).join('');
                    }
                }

                // 2. Мои студенты
                const myStudents = myApps.filter(a => a.status === 'APPROVED' || a.status === 'CONFIRMED_BY_HEAD');
                const studentsTbody = document.getElementById('teacherStudentsTable');
                if (studentsTbody) {
                    if (myStudents.length === 0) {
                        studentsTbody.innerHTML = '<tr><td colspan="5" class="py-6 text-center text-[#4A5873] dark:text-[#9FB0CC]">Закрепленных студентов пока нет</td></tr>';
                    } else {
                        studentsTbody.innerHTML = myStudents.map(s => `
                            <tr class="hover:bg-[#EEF1F8]/60 dark:hover:bg-[#0F1830]/40 transition">
                                <td class="py-2.5 px-3 font-semibold text-[#0F1B33] dark:text-[#EAF0FB]">${escapeHtml(s.student_name)}</td>
                                <td class="py-2.5 px-3 text-[#4A5873] dark:text-[#9FB0CC] font-medium">${escapeHtml(s.group_name || 'ВТиПО-22-1')}</td>
                                <td class="py-2.5 px-3 font-medium text-[#0F1B33] dark:text-[#EAF0FB] max-w-sm truncate" title="${escapeHtml(s.topic_title)}">${escapeHtml(s.topic_title)}</td>
                                <td class="py-2.5 px-3">
                                    <div class="w-28 bg-[#EEF1F8] dark:bg-[#0F1830] rounded-full h-1.5 overflow-hidden border border-[#DCE2EE] dark:border-[#24324F]">
                                        <div class="bg-[#2447B8] h-full rounded-full" style="width: 50%;"></div>
                                    </div>
                                </td>
                                <td class="py-2.5 px-3 text-right">
                                    <span class="px-2.5 py-0.5 rounded-md text-[11px] font-semibold uppercase tracking-wider ${s.status === 'CONFIRMED_BY_HEAD' ? 'bg-[#E6ECFB] text-[#2447B8] dark:bg-[#2447B8]/30 dark:text-[#9DB4E6] border border-[#9DB4E6]/50 dark:border-[#9DB4E6]/30' : 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800'}">
                                        ${s.status === 'CONFIRMED_BY_HEAD' ? 'В приказе' : 'Одобрено'}
                                    </span>
                                </td>
                            </tr>
                        `).join('');
                    }
                }

                // Динамическая квота мест преподавателя (реальные данные из API /api/teachers/load)
                let totalSlots = 0;
                let usedSlots = 0;
                let foundLoad = false;
                try {
                    const loadRes = await apiFetch('/api/teachers/load');
                    if (loadRes.ok) {
                        const loadList = await loadRes.json();
                        if (Array.isArray(loadList)) {
                            const myLoad = loadList.find(l => l.supervisor_name && (
                                l.supervisor_name.includes(currentUser.full_name) ||
                                currentUser.full_name.includes(l.supervisor_name.replace('Доц. ', '').replace('Проф. ', ''))
                            ));
                            if (myLoad) {
                                totalSlots = Number(myLoad.quota_total ?? 0);
                                usedSlots = Number(myLoad.quota_used ?? 0);
                                foundLoad = true;
                            }
                        }
                    }
                } catch (e) {}

                if (!foundLoad) {
                    const myTopics = (allTopics || []).filter(t => t.supervisor_name && (
                        t.supervisor_name.includes(currentUser.full_name) ||
                        currentUser.full_name.includes(t.supervisor_name.replace('Доц. ', '').replace('Проф. ', ''))
                    ));
                    totalSlots = myTopics.reduce((acc, t) => acc + (Number(t.slots_total) || 1), 0);
                    usedSlots = myStudents.length;
                }

                const quotaBadge = document.getElementById('teacherQuotaBadge');
                const lightBadge = document.getElementById('teacherTrafficLightBadge');
                if (quotaBadge) quotaBadge.textContent = `${usedSlots} / ${totalSlots} мест`;
                if (lightBadge) {
                    if (totalSlots > 0) {
                        const pct = (usedSlots / totalSlots) * 100;
                        if (pct >= 100) {
                            lightBadge.className = 'px-3.5 py-2 rounded-xl text-xs font-bold border text-purple-700 bg-purple-50 dark:bg-purple-950/40 border-purple-200 dark:border-purple-800';
                            lightBadge.textContent = tr('teacherLoadCritical', 'Квота заполнена • 100%');
                        } else if (pct >= 85) {
                            lightBadge.className = 'px-3.5 py-2 rounded-xl text-xs font-semibold border text-amber-800 bg-amber-50 dark:bg-amber-950/40 border-amber-200 dark:border-amber-900';
                            lightBadge.textContent = `${tr('teacherLoadHigh', 'Высокая нагрузка')} • ${Math.round(pct)}%`;
                        } else {
                            lightBadge.className = 'px-3.5 py-2 rounded-xl text-xs font-semibold border text-emerald-800 bg-emerald-50 dark:bg-emerald-950/40 border-emerald-200 dark:border-emerald-900';
                            lightBadge.textContent = `${tr('teacherLoadNormal', 'Нагрузка в норме')} • ${Math.round(pct)}%`;
                        }
                    } else {
                        lightBadge.className = 'px-3.5 py-2 rounded-xl text-xs font-medium border text-[#4A5873] bg-[#EEF1F8] dark:bg-[#0F1830] border-[#DCE2EE] dark:border-[#24324F]';
                        lightBadge.textContent = 'Нет данных';
                    }
                }
                loadTeacherCheckpoints();
            } catch (e) {
                console.warn('Teacher dashboard load error:', e);
            }
        }

