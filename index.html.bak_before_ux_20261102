        async function renderHeadCharts(stats = null) {
            if (!currentUser || (currentUser.role !== 'head' && currentUser.role !== 'admin')) return;

            try {
                if (!stats) {
                    const statsRes = await apiFetch('/api/head/stats');
                    if (statsRes.ok) {
                        try { stats = await statsRes.json(); } catch (e) { stats = {}; }
                    } else {
                        stats = {};
                    }
                }

                // График 1: Doughnut (Статус распределения) с центральной метрикой из данных API
                const streamCanvas = document.getElementById('streamAllocationChart');
                if (streamCanvas) {
                    const oldStream = Chart.getChart(streamCanvas);
                    if (oldStream) oldStream.destroy();
                    if (streamChartInstance) { streamChartInstance.destroy(); streamChartInstance = null; }

                    const confirmed = Number(stats.confirmed ?? (stats.confirmed_by_head || 0));
                    const pending = Number(stats.pending ?? 0);
                    const without = Number(stats.without_topic ?? (stats.pending_students || 0));
                    const totalStudents = stats.total_students != null ? Number(stats.total_students) : (confirmed + pending + without);

                    const centerNumEl = document.getElementById('streamChartCenterNum');
                    const centerLabelEl = document.getElementById('streamChartCenterLabel');
                    if (centerNumEl) centerNumEl.textContent = totalStudents > 0 ? String(totalStudents) : '0';
                    if (centerLabelEl) {
                        centerLabelEl.textContent = currentLang === 'kz' ? 'студент' : (currentLang === 'en' ? 'students' : 'студентов');
                    }

                    const isDark = document.documentElement.classList.contains('dark');
                    const labelsMap = {
                        ru: ['Утверждены в приказ', 'Ожидают решения', 'Без темы'],
                        kz: ['Бұйрыққа енгізілді', 'Шешім күтуде', 'Тақырыпсыз'],
                        en: ['Confirmed in Decree', 'Pending Decision', 'Without Topic']
                    };
                    const labels = labelsMap[currentLang] || labelsMap.ru;

                    const sumAll = confirmed + pending + without;
                    const chartData = sumAll > 0 ? [confirmed, pending, without] : [1];
                    const chartColors = sumAll > 0 ? [(isDark ? '#5B84E6' : '#2B4C9B'), (isDark ? '#E3A04A' : '#D98A2B'), (isDark ? '#3A4560' : '#CFD5E3')] : [isDark ? '#24324F' : '#DCE2EE'];

                    streamChartInstance = new Chart(streamCanvas, {
                        type: 'doughnut',
                        data: {
                            labels: labels,
                            datasets: [{
                                data: chartData,
                                backgroundColor: chartColors,
                                borderWidth: 0,
                                borderRadius: sumAll > 0 ? 4 : 0
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            cutout: '72%',
                            plugins: {
                                legend: {
                                    position: 'bottom',
                                    labels: {
                                        color: isDark ? '#EAF0FB' : '#0F1B33',
                                        font: { size: 11, weight: '600' },
                                        padding: 14,
                                        boxWidth: 10,
                                        boxHeight: 10,
                                        usePointStyle: true,
                                        pointStyle: 'circle'
                                    }
                                },
                                tooltip: {
                                    enabled: sumAll > 0,
                                    callbacks: {
                                        label: function(context) {
                                            const val = context.raw || 0;
                                            const pct = totalStudents > 0 ? ((val / totalStudents) * 100).toFixed(1) : 0;
                                            return ` ${context.label}: ${val} (${pct}%)`;
                                        }
                                    }
                                }
                            }
                        }
                    });
                }

                // График 2: Stacked Bar (Нагрузка научных руководителей) - реальные данные без вымышленных преподавателей
                const loadCanvas = document.getElementById('teachersLoadChart');
                if (loadCanvas) {
                    const oldLoad = Chart.getChart(loadCanvas);
                    if (oldLoad) oldLoad.destroy();
                    if (teachersChartInstance) { teachersChartInstance.destroy(); teachersChartInstance = null; }

                    const loadRes = await apiFetch('/api/teachers/load');
                    let loadData = [];
                    if (loadRes.ok) {
                        try { loadData = await loadRes.json(); } catch (e) {}
                    }

                    const teachersList = Array.isArray(loadData) ? loadData : [];
                    const isDark = document.documentElement.classList.contains('dark');
                    const textClr = isDark ? '#EAF0FB' : '#0F1B33';
                    const gridClr = isDark ? '#24324F' : '#DCE2EE';

                    const labels = teachersList.length > 0 
                        ? teachersList.map(d => (d.supervisor_name || 'Преподаватель').replace('Доц. ', '').replace('Проф. ', '').trim())
                        : ['Нет данных'];
                    const used = teachersList.length > 0 ? teachersList.map(d => Number(d.quota_used || 0)) : [0];
                    const free = teachersList.length > 0 ? teachersList.map(d => Math.max(0, Number(d.quota_total || 0) - Number(d.quota_used || 0))) : [0];

                    const labelUsed = currentLang === 'kz' ? 'Бекітілген' : (currentLang === 'en' ? 'Occupied' : 'Занято');
                    const labelFree = currentLang === 'kz' ? 'Бос орындар' : (currentLang === 'en' ? 'Available' : 'Свободно');

                    teachersChartInstance = new Chart(loadCanvas, {
                        type: 'bar',
                        data: {
                            labels: labels,
                            datasets: [
                                { label: labelUsed, data: used, backgroundColor: (isDark ? '#5B84E6' : '#2B4C9B'), borderRadius: 6 },
                                { label: labelFree, data: free, backgroundColor: (isDark ? '#31426A' : '#CBD5EA'), borderRadius: 4 }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                x: { stacked: true, ticks: { color: textClr, font: { weight: 'bold' } }, grid: { display: false } },
                                y: { stacked: true, beginAtZero: true, ticks: { color: textClr, precision: 0 }, grid: { color: gridClr } }
                            },
                            plugins: {
                                legend: { position: 'bottom', labels: { color: textClr, font: { size: 11, weight: 'bold' } } }
                            }
                        }
                    });
                }
            } catch (e) {
                console.warn('Charts render error:', e);
            }
        }

