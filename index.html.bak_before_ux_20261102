        // ─── 7. WEBSOCKET СОЕДИНЕНИЕ (СИНГЛТОН С ЗАЩИТОЙ ОТ ПОВТОРОВ И РЕКОННЕКТ-ПЕТЛИ) ───
        let currentWsUserId = null;
        let isWsManualClose = false;

        function closeWebSocket() {
            isWsManualClose = true;
            if (wsReconnectTimer) {
                clearTimeout(wsReconnectTimer);
                wsReconnectTimer = null;
            }
            if (wsConnection) {
                wsConnection.onopen = null;
                wsConnection.onmessage = null;
                wsConnection.onerror = null;
                wsConnection.onclose = null;
                try {
                    wsConnection.close(1000, 'Normal Closure');
                } catch (e) {}
                wsConnection = null;
            }
            currentWsUserId = null;
        }

        function connectWebSocket(userId) {
            // Если пользователь не передан или не авторизован - закрываем соединение
            if (!userId || !currentUser || currentUser.id !== userId) {
                closeWebSocket();
                return;
            }

            // Если уже есть открытое или открывающееся соединение для текущего пользователя - НЕ переподключаемся
            if (wsConnection && currentWsUserId === userId) {
                if (wsConnection.readyState === WebSocket.OPEN || wsConnection.readyState === WebSocket.CONNECTING) {
                    return;
                }
            }

            // Безопасно закрываем старый сокет перед новым подключением
            closeWebSocket();
            isWsManualClose = false;
            currentWsUserId = userId;

            const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
            const token = localStorage.getItem('meta_token');
            const wsUrl = `${protocol}//${window.location.host}/ws/${userId}${token ? `?token=${encodeURIComponent(token)}` : ''}`;

            try {
                wsConnection = new WebSocket(wsUrl);

                wsConnection.onopen = () => {
                    console.log(`WebSocket connected for user ${userId}`);
                    wsReconnectAttempts = 0;
                };

                wsConnection.onmessage = async (event) => {
                    try {
                        const msg = JSON.parse(event.data);
                        handleWebSocketMessage(msg);
                    } catch (e) {
                        console.warn('WS message parse error:', e);
                    }
                };

                wsConnection.onclose = (event) => {
                    const code = event ? event.code : 0;
                    console.log('WebSocket closed.', code);

                    // Если соединение закрыто вручную (logout / смена пользователя) - реконнект запрещен
                    if (isWsManualClose) return;

                    // Нормальное закрытие или ошибка авторизации - реконнект запрещен
                    if (code === 1000 || code === 4001 || code === 4003 || code === 1008 || code === 4401 || code === 4403) {
                        console.warn('WebSocket closed normally or auth rejected. Reconnect aborted.');
                        return;
                    }

                    // Реконнект только при неожиданном обрыве сети и наличии авторизованного пользователя
                    if (currentUser && currentUser.id === userId) {
                        if (wsReconnectAttempts >= 5) {
                            console.warn('Max WebSocket reconnect attempts (5) reached. Reconnect stopped.');
                            return;
                        }
                        wsReconnectAttempts++;
                        // Экспоненциальный backoff с задержкой от 2с до 20с
                        const delay = Math.min(2000 * Math.pow(2, wsReconnectAttempts - 1), 20000);
                        console.log(`WebSocket reconnecting in ${delay}ms (attempt ${wsReconnectAttempts}/5)...`);
                        wsReconnectTimer = setTimeout(() => {
                            if (!wsConnection || wsConnection.readyState === WebSocket.CLOSED) {
                                connectWebSocket(userId);
                            }
                        }, delay);
                    }
                };

                wsConnection.onerror = (err) => {
                    console.warn('WebSocket error:', err);
                };
            } catch (e) {
                console.warn('Failed to initialize WebSocket:', e);
            }
        }

        function handleWebSocketMessage(msg) {
            // Звук / вибрация при событии если поддерживается
            if (msg.event === 'APPLICATION_STATUS_CHANGED') {
                if (msg.status === 'APPROVED') {
                    showToast('🎉 Заявка одобрена!', msg.message || 'Руководитель утвердил выбранную тему.', 'success');
                } else if (msg.status === 'REJECTED') {
                    showToast('❌ Заявка отклонена', msg.message || 'Заявка отклонена руководителем.', 'error');
                }
                loadStudentDashboard();
                loadTopics();
            } else if (msg.event === 'NEW_APPLICATION_SUBMITTED') {
                showToast('📩 Новая заявка студента', `Подана заявка на тему: ${msg.topic_title || ''}`, 'info');
                if (currentUser?.role === 'teacher') loadTeacherDashboard();
                if (currentUser?.role === 'head') loadHeadDashboard();
            } else if (msg.event === 'CHECKPOINT_SUBMITTED') {
                showToast('📤 Загружен отчет ВКР', `Студент сдал отчет к этапу: ${msg.title || ''}`, 'info');
                if (currentUser?.role === 'teacher') loadTeacherDashboard();
            } else if (msg.event === 'CHECKPOINT_REVIEWED') {
                const isAcc = msg.status === 'ACCEPTED';
                showToast(
                    isAcc ? '✅ Этап ВКР зачтен!' : '⚠️ Этап отправлен на доработку',
                    `Этап «${msg.title || ''}»: ${isAcc ? 'Замечаний нет' : (msg.comment || 'Требуются правки')}`,
                    isAcc ? 'success' : 'warning'
                );
                if (currentUser?.role === 'student') loadStudentDashboard();
            } else if (msg.event === 'DISTRIBUTION_FINISHED') {
                showToast('🎯 Распределение завершено', 'Кафедра утвердила автоматическое распределение тем Гейла–Шепли!', 'success');
                if (currentUser?.role === 'student') loadStudentDashboard();
                if (currentUser?.role === 'head') loadHeadDashboard();
                loadTopics();
            } else if (msg.event === 'DEMO_RESET') {
                showToast('↺ Демо сброшено', msg.message || 'Демонстрационная база данных возвращена в исходное состояние', 'info');
                if (currentUser) {
                    if (currentUser.role === 'student') {
                        loadStudentDashboard();
                        loadStudentCheckpoints();
                        loadStudentActivityFeed();
                    } else if (currentUser.role === 'teacher') {
                        loadTeacherDashboard();
                    } else if (currentUser.role === 'head' || currentUser.role === 'admin') {
                        loadHeadDashboard();
                    }
                    loadTopics();
                }
            }

            fetchNotifications();
        }

        // ─── 8. УПРАВЛЕНИЕ УВЕДОМЛЕНИЯМИ (NOTIFICATION CENTER) ───
        async function fetchNotifications() {
            if (!currentUser) return;
            try {
                const res = await apiFetch('/api/notifications');
                if (!res.ok) return;
                const notifs = await res.json();

                const badge = document.getElementById('notifBadge');
                const list = document.getElementById('notifList');
                const unreadCount = notifs.filter(n => !n.is_read).length;

                if (badge) {
                    if (unreadCount > 0) {
                        badge.textContent = unreadCount > 9 ? '9+' : unreadCount;
                        badge.classList.remove('hidden');
                        badge.classList.add('flex');
                    } else {
                        badge.classList.add('hidden');
                        badge.classList.remove('flex');
                    }
                }

                if (list) {
                    if (notifs.length === 0) {
                        list.innerHTML = '<div class="text-center py-6 text-slate-400">Нет уведомлений</div>';
                    } else {
                        list.innerHTML = notifs.map(n => `
                            <div class="p-2.5 rounded-xl transition ${n.is_read ? 'bg-slate-50 dark:bg-slate-800/40 text-slate-500' : 'bg-rose-50/80 dark:bg-rose-950/30 text-slate-900 dark:text-white font-bold border-l-2 border-rose-500'}">
                                <div class="flex items-center justify-between text-[11px] mb-0.5">
                                    <span class="font-extrabold ${n.is_read ? 'text-slate-600 dark:text-slate-400' : 'text-rose-600 dark:text-rose-400'}">${escapeHtml(n.title)}</span>
                                    <span class="text-[10px] text-slate-400 font-normal">${escapeHtml(n.created_at)}</span>
                                </div>
                                <div class="text-xs leading-snug">${escapeHtml(n.message)}</div>
                            </div>
                        `).join('');
                    }
                }
            } catch (e) {
                console.warn('Failed to fetch notifications:', e);
            }
