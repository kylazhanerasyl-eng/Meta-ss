        let currentLang = localStorage.getItem('meta_lang') || 'ru';
        let currentUser = null;
        let allTopics = [];
        let currentDeptFilter = 'all';
        let wsConnection = null;
        let wsReconnectTimer = null;
        let wsReconnectAttempts = 0;
