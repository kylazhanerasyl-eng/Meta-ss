            <div class="space-y-2.5 text-xs text-[#4A5873] dark:text-[#9FB0CC] border-t border-b border-[#DCE2EE] dark:border-[#24324F] py-3.5">
                <div><span class="font-semibold text-[#0F1B33] dark:text-[#EAF0FB]">Требуемый стек:</span> <span id="passportSkills" class="font-medium text-[#2447B8] dark:text-[#9DB4E6]"></span></div>
                <div><span class="font-semibold text-[#0F1B33] dark:text-[#EAF0FB]">Сложность:</span> <span id="passportDifficulty" class="font-medium text-[#0F1B33] dark:text-[#EAF0FB]"></span></div>
                <div><span class="font-semibold text-[#0F1B33] dark:text-[#EAF0FB]">Квота мест:</span> <span id="passportQuota" class="font-medium text-[#0F1B33] dark:text-[#EAF0FB]"></span></div>
