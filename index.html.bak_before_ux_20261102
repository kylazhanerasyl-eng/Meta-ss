            <div class="space-y-4">
                <div class="border-2 border-dashed border-[#DCE2EE] dark:border-[#24324F] rounded-2xl p-6 text-center hover:border-[#2447B8] transition bg-[#EEF1F8]/60 dark:bg-[#0F1830]/40">
                    <input type="file" id="normDocxInput" accept=".docx" class="hidden" onchange="handleNormFileSelected(this)">
                    <label for="normDocxInput" class="cursor-pointer flex flex-col items-center">
                        <svg class="w-10 h-10 text-[#4A5873] dark:text-[#9FB0CC] mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        <span id="normDocxFileName" class="text-xs font-semibold text-[#0F1B33] dark:text-[#EAF0FB]">Выберите файл в формате .docx</span>
                        <span class="text-[11px] text-[#4A5873] dark:text-[#9FB0CC] mt-0.5">Максимальный размер: 25 МБ</span>
                    </label>
                </div>

                <button id="normCheckBtn" onclick="runNormControlCheck()" class="w-full bg-[#2447B8] hover:bg-[#1B3794] text-white py-2.5 rounded-xl font-semibold text-xs cursor-pointer shadow-sm flex items-center justify-center gap-2 transition">
                    <span id="normCheckBtnText">Проверить документ на соответствие ГОСТ</span>
                </button>

                <!-- Результат нормоконтроля -->
                <div id="normResultBlock" class="hidden p-5 bg-[#EEF1F8] dark:bg-[#0F1830]/60 rounded-2xl border border-[#DCE2EE] dark:border-[#24324F] space-y-3.5">
                    <div class="flex items-center justify-between">
                        <div>
                            <div class="text-[10px] font-semibold uppercase text-[#4A5873] dark:text-[#9FB0CC]">Общий балл соответствия:</div>
                            <div id="normScoreBadge" class="text-2xl font-bold text-emerald-600 mt-0.5">85 / 100</div>
                        </div>
                        <span id="normStatusPill" class="px-3 py-1 rounded-full text-xs font-semibold uppercase bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300">
                            EXCELLENT
                        </span>
                    </div>

