/* ─── Главная: сетка + кольца + мягкий свет ─── */
.meta-landing{position:fixed;isolation:isolate;background:transparent!important}
.meta-landing::before{display:block!important;content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;
 background:
  radial-gradient(circle at 50% 46%,transparent 0 150px,var(--ring) 150px 151px,transparent 151px 250px,var(--ring) 250px 251px,transparent 251px 370px,var(--ring) 370px 371px,transparent 371px 510px,var(--ring) 510px 511px,transparent 511px),
  linear-gradient(var(--gridc) 1px,transparent 1px) 0 0/56px 56px,
  linear-gradient(90deg,var(--gridc) 1px,transparent 1px) 0 0/56px 56px;
 -webkit-mask-image:radial-gradient(ellipse 70% 65% at 50% 46%,#000 25%,transparent 78%);mask-image:radial-gradient(ellipse 70% 65% at 50% 46%,#000 25%,transparent 78%)}
.meta-landing::after{content:"";position:absolute;z-index:-1;left:50%;top:44%;width:640px;height:640px;transform:translate(-50%,-50%);border-radius:50%;pointer-events:none;background:radial-gradient(circle,var(--halo),transparent 65%)}
