        async function acceptCheckpointDirect(cpId) {
            try {
                const res = await apiFetch('/api/checkpoints/review', {
                    method: 'POST',
                    body: {
                        checkpoint_id: cpId,
                        status: 'ACCEPTED',
                        comment: 'Отчет проверен и принят научным руководителем.'
                    }
                });
                if (res.ok) {
                    showToast('Успешно зачтено', 'Результат зафиксирован', 'success');
                    loadTeacherCheckpoints();
                }
            } catch (e) {}
        }

        function openReviewRevisionModal(cpIdOrEl, title, studentName) {
            let cpId = cpIdOrEl;
            if (cpIdOrEl && typeof cpIdOrEl === 'object' && cpIdOrEl.dataset) {
                cpId = cpIdOrEl.dataset.cpId;
                title = cpIdOrEl.dataset.title;
                studentName = cpIdOrEl.dataset.student;
            }
            const modal = document.getElementById('checkpointReviewModal');
            const idEl = document.getElementById('reviewModalCheckpointId');
            if (idEl) idEl.value = cpId || '';
            const subEl = document.getElementById('reviewModalSubtitle');
            if (subEl) subEl.textContent = `Студент: ${studentName || ''} • ${title || ''}`;
            const comEl = document.getElementById('reviewModalComment');
            if (comEl) comEl.value = '';
            notifyModalOpen(modal);
        }

        function closeReviewModal() {
            const modal = document.getElementById('checkpointReviewModal');
            notifyModalClose(modal);
        }

        async function submitReviewRevision() {
            const cpId = document.getElementById('reviewModalCheckpointId')?.value;
            const comment = document.getElementById('reviewModalComment')?.value?.trim();
            const btn = document.getElementById('submitReviewBtn');
            if (!comment) {
                showToast('Ошибка', 'Обязательно укажите замечание для студента', 'error');
                return;
            }

            if (btn) { btn.disabled = true; btn.textContent = 'Отправка...'; }
            try {
                const res = await apiFetch('/api/checkpoints/review', {
                    method: 'POST',
                    body: {
                        checkpoint_id: parseInt(cpId),
                        status: 'REVISION',
                        comment: comment
                    }
                });
                if (res.ok) {
                    showToast('Отправлено', 'Замечание отправлено студенту', 'warning');
                    closeReviewModal();
                    loadTeacherCheckpoints();
                } else {
                    showToast('Ошибка', 'Не удалось сохранить замечание', 'error');
                }
            } catch (e) {
                showToast('Ошибка сети', 'Не удалось отправить замечание', 'error');
            } finally {
                if (btn) { btn.disabled = false; btn.textContent = 'Отправить замечание'; }
            }
        }

