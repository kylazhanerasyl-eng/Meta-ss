                <div class="flex flex-wrap gap-2 justify-center">
                    <button onclick="quickLogin('student@test.com')" class="text-xs bg-[#EEF1F8] dark:bg-[#0F1830] hover:bg-[#E6ECFB] dark:hover:bg-[#24324F] px-3 py-1.5 rounded-lg font-medium text-[#0F1B33] dark:text-[#EAF0FB] border border-[#DCE2EE] dark:border-[#24324F] transition">Студент</button>
                    <button onclick="quickLogin('teacher@test.com')" class="text-xs bg-[#EEF1F8] dark:bg-[#0F1830] hover:bg-[#E6ECFB] dark:hover:bg-[#24324F] px-3 py-1.5 rounded-lg font-medium text-[#0F1B33] dark:text-[#EAF0FB] border border-[#DCE2EE] dark:border-[#24324F] transition">Преподаватель</button>
                    <button onclick="quickLogin('head@test.com')" class="text-xs bg-[#EEF1F8] dark:bg-[#0F1830] hover:bg-[#E6ECFB] dark:hover:bg-[#24324F] px-3 py-1.5 rounded-lg font-medium text-[#0F1B33] dark:text-[#EAF0FB] border border-[#DCE2EE] dark:border-[#24324F] transition">Завкафедрой</button>
                </div>
            </div>
        </div>
