/* фон и наведение */
html:not(.dark) body{background-image:radial-gradient(900px 500px at 8% -5%,rgba(43,76,155,.07),transparent 60%),radial-gradient(800px 500px at 100% 0%,rgba(217,138,43,.07),transparent 55%),linear-gradient(180deg,#F8F7F4,#F3F2EE)!important;background-attachment:fixed}
html.dark body{background-image:radial-gradient(900px 560px at 6% -8%,rgba(91,132,230,.16),transparent 60%),radial-gradient(800px 520px at 100% 8%,rgba(120,90,220,.10),transparent 55%),radial-gradient(900px 600px at 50% 120%,rgba(40,160,170,.08),transparent 60%),linear-gradient(180deg,#0E121B,#10151F)!important;background-attachment:fixed}
