        async function decideApplication(appId, decision, reason = null) {
            try {
                const res = await apiFetch('/api/applications/decide', {
                    method: 'POST',
                    body: {
                        application_id: parseInt(appId),
                        decision: decision,
                        reason: reason
                    }
                });
                const data = await res.json();
                if (res.ok) {
                    showToast(decision === 'APPROVE' ? 'Заявка одобрена!' : 'Заявка отклонена', '', decision === 'APPROVE' ? 'success' : 'warning');
