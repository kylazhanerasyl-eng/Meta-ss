        function switchTeacherTab(tab) {
            activeTeacherTab = tab;
            const tabs = ['apps', 'students', 'checkpoints', 'proposals'];
            tabs.forEach(t => {
                const btn = document.getElementById(`tabTeacher${t.charAt(0).toUpperCase() + t.slice(1)}Btn`);
                const content = document.getElementById(`teacherTab${t.charAt(0).toUpperCase() + t.slice(1)}`);
                if (btn && content) {
                    if (t === tab) {
                        btn.className = 'px-4 py-2.5 text-xs font-semibold border-b-2 border-[#2447B8] text-[#2447B8] dark:text-[#9DB4E6] cursor-pointer';
