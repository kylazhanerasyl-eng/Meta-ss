    <!-- 2. Модальное окно подачи заявки с приоритетом (1, 2, 3) -->
    <div id="applyModal" class="hidden modal-backdrop inset-0 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
        <div class="bg-[#FFFFFF] dark:bg-[#111A2E] rounded-2xl p-7 max-w-lg w-full shadow-2xl border border-[#DCE2EE] dark:border-[#24324F] relative">
            <button onclick="closeApplyModal()" class="absolute top-4 right-4 text-[#4A5873] hover:text-[#0F1B33] dark:text-[#9FB0CC] dark:hover:text-[#EAF0FB] text-lg font-bold cursor-pointer">✕</button>
            <div class="flex items-center gap-2 mb-1">
                <span class="text-[#2447B8] dark:text-[#9DB4E6] font-semibold text-xs uppercase tracking-wide">Выбор темы диплома</span>
            </div>
            <h3 id="applyModalTopicTitle" class="text-lg font-bold text-[#0F1B33] dark:text-[#EAF0FB] mb-1">Название темы</h3>
            <p id="applyModalSupervisor" class="text-xs text-[#4A5873] dark:text-[#9FB0CC] mb-4">Руководитель: Доц. Ахметов К.А.</p>

            <form onsubmit="handleApplySubmit(event)" class="space-y-4">
                <input type="hidden" id="applyTopicId">
                <div>
                    <label class="block text-xs font-semibold text-[#0F1B33] dark:text-[#EAF0FB] mb-2">Приоритет выбора (1, 2 или 3):</label>
                    <div class="grid grid-cols-3 gap-2.5">
                        <label class="flex flex-col items-center p-3 rounded-xl border border-[#DCE2EE] dark:border-[#24324F] cursor-pointer has-[:checked]:border-[#2447B8] has-[:checked]:bg-[#E6ECFB]/50 dark:has-[:checked]:bg-[#2447B8]/20 transition">
                            <input type="radio" name="applyPriority" value="1" checked class="accent-[#2447B8] mb-1">
                            <span class="text-xs font-semibold text-[#0F1B33] dark:text-[#EAF0FB]">1-й приоритет</span>
                            <span class="text-[10px] text-[#4A5873] dark:text-[#9FB0CC] text-center mt-0.5">Основной выбор</span>
                        </label>
                        <label class="flex flex-col items-center p-3 rounded-xl border border-[#DCE2EE] dark:border-[#24324F] cursor-pointer has-[:checked]:border-[#2447B8] has-[:checked]:bg-[#E6ECFB]/50 dark:has-[:checked]:bg-[#2447B8]/20 transition">
                            <input type="radio" name="applyPriority" value="2" class="accent-[#2447B8] mb-1">
                            <span class="text-xs font-semibold text-[#0F1B33] dark:text-[#EAF0FB]">2-й приоритет</span>
                            <span class="text-[10px] text-[#4A5873] dark:text-[#9FB0CC] text-center mt-0.5">Второй выбор</span>
                        </label>
                        <label class="flex flex-col items-center p-3 rounded-xl border border-[#DCE2EE] dark:border-[#24324F] cursor-pointer has-[:checked]:border-[#2447B8] has-[:checked]:bg-[#E6ECFB]/50 dark:has-[:checked]:bg-[#2447B8]/20 transition">
                            <input type="radio" name="applyPriority" value="3" class="accent-[#2447B8] mb-1">
                            <span class="text-xs font-semibold text-[#0F1B33] dark:text-[#EAF0FB]">3-й приоритет</span>
                            <span class="text-[10px] text-[#4A5873] dark:text-[#9FB0CC] text-center mt-0.5">Резервный выбор</span>
                        </label>
                    </div>
                    <p class="text-[11px] text-[#4A5873] dark:text-[#9FB0CC] mt-2">При распределении алгоритмом Гейла–Шепли учитываются указанный приоритет, академический рейтинг (GPA) и квота руководителя.</p>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-[#0F1B33] dark:text-[#EAF0FB] mb-1.5">Обоснование и опыт работы:</label>
                    <textarea id="applyMotivationInput" rows="3" class="w-full p-3 bg-[#EEF1F8]/60 dark:bg-[#0F1830] border border-[#DCE2EE] dark:border-[#24324F] rounded-xl text-xs font-medium outline-none focus:ring-2 focus:ring-[#2447B8] text-[#0F1B33] dark:text-[#EAF0FB]" placeholder="Укажите ваши навыки, технологии и почему хотите выполнять данный проект..."></textarea>
                </div>

                <div class="flex justify-end gap-2.5 pt-1">
                    <button type="button" onclick="closeApplyModal()" class="px-4 py-2 rounded-xl text-xs font-medium bg-[#EEF1F8] dark:bg-[#0F1830] text-[#0F1B33] dark:text-[#EAF0FB] hover:bg-[#E6ECFB] dark:hover:bg-[#24324F] border border-[#DCE2EE] dark:border-[#24324F] cursor-pointer transition">Отмена</button>
                    <button id="applySubmitBtn" type="submit" class="bg-[#2447B8] hover:bg-[#1B3794] text-white px-5 py-2 rounded-xl text-xs font-semibold shadow-sm cursor-pointer transition">
                        Отправить заявку
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- 3. Модальное окно: Предложить свою тему + Академическая формулировка -->
    <div id="customTopicModal" class="hidden modal-backdrop inset-0 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
        <div class="bg-[#FFFFFF] dark:bg-[#111A2E] rounded-2xl p-7 max-w-xl w-full shadow-2xl border border-[#DCE2EE] dark:border-[#24324F] relative max-h-[90vh] overflow-y-auto">
            <button onclick="closeCustomTopicModal()" class="absolute top-4 right-4 text-[#4A5873] hover:text-[#0F1B33] dark:text-[#9FB0CC] dark:hover:text-[#EAF0FB] text-lg font-bold cursor-pointer">✕</button>
            <div class="flex items-center gap-2 mb-1">
                <span class="text-xs font-semibold uppercase tracking-wide text-[#2447B8] dark:text-[#9DB4E6]">Инициативная тема</span>
            </div>
            <h3 class="text-lg font-bold text-[#0F1B33] dark:text-[#EAF0FB] mb-1">Формулировка темы дипломного проекта</h3>
            <p class="text-xs text-[#4A5873] dark:text-[#9FB0CC] mb-4">Автоматическая нормализация формулировки по академическим стандартам и проверка на дубликаты.</p>

            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-[#0F1B33] dark:text-[#EAF0FB] mb-1">Краткое описание вашей идеи:</label>
                    <textarea id="customIdeaInput" rows="3" placeholder="Например: информационная система учета и диспетчеризации доставки грузов с оптимизацией маршрутов" class="w-full p-3 bg-[#EEF1F8]/60 dark:bg-[#0F1830] border border-[#DCE2EE] dark:border-[#24324F] rounded-xl text-xs font-medium outline-none focus:ring-2 focus:ring-[#2447B8] text-[#0F1B33] dark:text-[#EAF0FB]"></textarea>
                </div>
                <button id="customAiRefineBtn" onclick="handleAiRefineTopic()" class="w-full bg-[#2447B8] hover:bg-[#1B3794] text-white py-2 rounded-xl font-semibold text-xs cursor-pointer shadow-sm flex items-center justify-center gap-2 transition">
                    Сформировать академическую тему
                </button>

                <!-- Блок результата AI -->
                <div id="customAiResultBlock" class="hidden p-4 bg-[#EEF1F8] dark:bg-[#0F1830]/60 rounded-xl border border-[#DCE2EE] dark:border-[#24324F] space-y-3 text-xs">
                    <div>
                        <div class="text-[10px] font-semibold text-[#4A5873] dark:text-[#9FB0CC] uppercase tracking-wide">Тема на русском языке:</div>
                        <div id="aiResTitleRu" class="font-bold text-[#0F1B33] dark:text-[#EAF0FB] text-sm mt-0.5"></div>
                    </div>
                    <div>
                        <div class="text-[10px] font-semibold text-[#4A5873] dark:text-[#9FB0CC] uppercase tracking-wide">Тақырыбы (қазақша):</div>
                        <div id="aiResTitleKz" class="font-medium text-[#0F1B33] dark:text-[#EAF0FB] mt-0.5"></div>
                    </div>
                    <div>
                        <div class="text-[10px] font-semibold text-[#4A5873] dark:text-[#9FB0CC] uppercase tracking-wide">Topic (English):</div>
                        <div id="aiResTitleEn" class="font-medium text-[#0F1B33] dark:text-[#EAF0FB] mt-0.5"></div>
                    </div>
                    <div class="grid grid-cols-2 gap-2 pt-2 border-t border-[#DCE2EE] dark:border-[#24324F]">
                        <div>
                            <span class="text-[#4A5873] dark:text-[#9FB0CC]">Направление:</span>
                            <span id="aiResCategory" class="font-semibold text-[#2447B8] dark:text-[#9DB4E6] ml-1">WEB</span>
                        </div>
                        <div>
                            <span class="text-[#4A5873] dark:text-[#9FB0CC]">Сложность:</span>
                            <span id="aiResDifficulty" class="font-semibold text-[#0F1B33] dark:text-[#EAF0FB] ml-1">4 / 5</span>
                        </div>
                    </div>
                    <div>
                        <span class="text-[#4A5873] dark:text-[#9FB0CC]">Ключевые слова:</span>
                        <div id="aiResKeywords" class="flex flex-wrap gap-1 mt-1 font-medium text-[#4A5873] dark:text-[#9FB0CC]"></div>
                    </div>

                    <!-- Проверка на антидубликат -->
                    <div class="pt-3 border-t border-[#DCE2EE] dark:border-[#24324F]">
                        <button id="customDupCheckBtn" onclick="handleDuplicateCheck()" class="w-full py-2 rounded-xl font-semibold text-xs bg-[#FFFFFF] dark:bg-[#111A2E] text-[#0F1B33] dark:text-[#EAF0FB] hover:bg-[#E6ECFB] dark:hover:bg-[#24324F] transition cursor-pointer flex items-center justify-center gap-1.5 border border-[#DCE2EE] dark:border-[#24324F]">
                            Проверить на дубликаты в базе кафедры
                        </button>
                        <div id="customDupResult" class="hidden mt-2.5 p-2.5 rounded-xl text-xs font-medium"></div>
                    </div>

                    <button id="customSubmitBtn" onclick="submitCustomTopicProposal()" class="w-full bg-[#2447B8] hover:bg-[#1B3794] text-white py-2.5 rounded-xl font-semibold text-xs cursor-pointer shadow-sm mt-2 flex items-center justify-center gap-1.5 transition">
                        Отправить на согласование руководителю
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Паспорт темы (Модалка) -->
    <div id="passportModal" class="hidden modal-backdrop inset-0 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
        <div class="bg-[#FFFFFF] dark:bg-[#111A2E] rounded-2xl p-7 max-w-xl w-full shadow-2xl border border-[#DCE2EE] dark:border-[#24324F] relative max-h-[90vh] overflow-y-auto">
            <button onclick="closePassportModal()" class="absolute top-4 right-4 text-[#4A5873] hover:text-[#0F1B33] dark:text-[#9FB0CC] dark:hover:text-[#EAF0FB] text-lg font-bold cursor-pointer">✕</button>
