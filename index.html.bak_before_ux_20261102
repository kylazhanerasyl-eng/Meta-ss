        // ─── МЕНЕДЖЕР ФОКУСА МОДАЛЬНЫХ ОКОН (WCAG 2.1 AA) ───
        let activeModalTrigger = null;
        let currentOpenModal = null;
        const modalFocusStack = [];

        function getModalFocusableElements(modalEl) {
            return Array.from(modalEl.querySelectorAll('button, [href], input, select, textarea, [tabindex]')).filter(el =>
                !el.disabled && el.type !== 'hidden' && el.tabIndex >= 0 &&
                !el.closest('[hidden], [inert], .hidden') && el.getClientRects().length > 0
            );
        }

        function notifyModalOpen(modalEl, triggerEl = null) {
            if (!modalEl) return;
            let entry = modalFocusStack.find(item => item.modal === modalEl);
            if (!entry) {
                entry = { modal: modalEl, trigger: triggerEl || document.activeElement };
                modalFocusStack.push(entry);
            } else {
                modalFocusStack.splice(modalFocusStack.indexOf(entry), 1);
                modalFocusStack.push(entry);
            }
            currentOpenModal = modalEl;
            activeModalTrigger = entry.trigger;
            modalEl.classList.remove('hidden');
            modalEl.style.display = 'flex';
            modalEl.setAttribute('role', 'dialog');
            modalEl.setAttribute('aria-modal', 'true');
            if (!modalEl.hasAttribute('tabindex')) modalEl.setAttribute('tabindex', '-1');
            setTimeout(() => {
                if (currentOpenModal !== modalEl || !modalEl.isConnected || modalEl.classList.contains('hidden')) return;
                (getModalFocusableElements(modalEl)[0] || modalEl).focus();
            }, 0);
        }

        function notifyModalClose(modalEl) {
            if (!modalEl) return;
            modalEl.classList.add('hidden');
            modalEl.style.display = 'none';
            const index = modalFocusStack.findIndex(item => item.modal === modalEl);
            if (index === -1) return;
            const wasCurrent = currentOpenModal === modalEl;
            const [entry] = modalFocusStack.splice(index, 1);
            const previous = modalFocusStack[modalFocusStack.length - 1];
            currentOpenModal = previous ? previous.modal : null;
            activeModalTrigger = previous ? previous.trigger : null;
            if (!wasCurrent) return;
            const trigger = entry.trigger;
            if (trigger && trigger.isConnected && !trigger.disabled && trigger.getClientRects().length > 0 &&
                (!currentOpenModal || currentOpenModal.contains(trigger))) trigger.focus();
            else if (currentOpenModal) (getModalFocusableElements(currentOpenModal)[0] || currentOpenModal).focus();
        }

        function handleModalKeydown(e) {
            const modal = currentOpenModal;
            if (!modal) return;
            if (e.key === 'Escape') {
                e.preventDefault();
                const actions = {
                    authModal: closeAuthModal, applyModal: closeApplyModal,
                    customTopicModal: closeCustomTopicModal, passportModal: closePassportModal,
                    normControlModal: closeNormControlModal, galeShapleyModal: closeGaleShapleyModal,
                    rejectReasonModal: closeRejectReasonModal, checkpointReviewModal: closeReviewModal,
                    checkpointHistoryModal: closeHistoryModal
                };
                const close = actions[modal.id];
                if (close) close();
                else notifyModalClose(modal);
            } else if (e.key === 'Tab') {
                const focusables = getModalFocusableElements(modal);
                const first = focusables[0];
                const last = focusables[focusables.length - 1];
                if (!first) {
                    e.preventDefault();
                    modal.focus();
                } else if (!modal.contains(document.activeElement) ||
                           (e.shiftKey && document.activeElement === first) ||
                           (!e.shiftKey && document.activeElement === last)) {
                    e.preventDefault();
                    (e.shiftKey ? last : first).focus();
                }
            }
        }

