        async function loadCompanyDashboard() {
            const title = document.getElementById('coTitle');
            if (title && currentUser) title.textContent = currentUser.full_name;
            const list = document.getElementById('coTopicsList');
            const body = document.getElementById('coBidsBody');
            try {
                const [tRes, bRes] = await Promise.all([
                    apiFetch('/api/topics'),
                    apiFetch('/api/company/bids?company_id=' + encodeURIComponent(currentUser.id))
                ]);
