        // ─── 3. ЕДИНЫЙ API FETCH HELPER (С АВТО-ТОКЕНОМ И ОБРАБОТКОЙ 401/403) ───
        async function apiFetch(url, options = {}) {
            options = options || {};
            options.headers = options.headers || {};
            const token = localStorage.getItem('meta_token');

            if (token) {
                if (options.headers instanceof Headers) {
                    options.headers.set('Authorization', 'Bearer ' + token);
                } else {
                    options.headers['Authorization'] = 'Bearer ' + token;
                }
            }

            // Очищаем Content-Type для FormData (браузер сам сформирует boundary)
            if (options.body instanceof FormData) {
                if (options.headers instanceof Headers) {
                    options.headers.delete('Content-Type');
                } else {
                    delete options.headers['Content-Type'];
                }
            } else if (options.body && typeof options.body === 'object') {
                options.body = JSON.stringify(options.body);
                if (options.headers instanceof Headers) {
                    if (!options.headers.has('Content-Type')) options.headers.set('Content-Type', 'application/json');
                } else {
                    if (!options.headers['Content-Type']) options.headers['Content-Type'] = 'application/json';
                }
            }

            try {
                const res = await fetch(url, options);

                if (res.status === 401) {
                    console.warn('Session expired or unauthorized (401)');
                    logout(true);
                    showToast('Сессия истекла', 'Пожалуйста, выполните вход заново', 'warning');
                    openAuthModal('login');
                    return res;
                }

                if (res.status === 403) {
                    let errMsg = 'Доступ запрещен (недостаточно прав)';
                    try {
                        const errData = await res.clone().json();
                        if (errData.detail) errMsg = errData.detail;
                    } catch (e) {}
                    showToast('Ошибка доступа', errMsg, 'error');
                }

                return res;
            } catch (err) {
                console.error('Network/API error:', err);
                showToast('Ошибка сети', 'Не удалось связаться с сервером', 'error');
                throw err;
            }
        }

        async function downloadAuthenticatedFile(e, url, defaultName) {
            if (e) e.preventDefault();
            let objUrl = null;
            let a = null;
            try {
                const res = await apiFetch(url);
                if (!res.ok) {
                    showToast('Ошибка', 'Не удалось скачать файл', 'error');
                    return;
                }
                const blob = await res.blob();
                objUrl = window.URL.createObjectURL(blob);
                a = document.createElement('a');
                a.href = objUrl;
                let fileName = defaultName;
                const disposition = res.headers.get('Content-Disposition') || '';
                const encodedMatch = disposition.match(/filename\*\s*=\s*UTF-8''([^;]+)/i);
                let decoded = null;
                if (encodedMatch) {
                    try {
                        decoded = decodeURIComponent(encodedMatch[1].trim());
                    } catch (err) {}
                }
                if (decoded) {
                    fileName = decoded;
                } else {
                    const plainMatch = disposition.match(/filename\s*=\s*(?:"([^"]+)"|([^;]+))/i);
                    if (plainMatch) {
                        fileName = (plainMatch[1] || plainMatch[2]).trim();
                    }
                }
                a.download = fileName;
                document.body.appendChild(a);
                a.click();
            } catch (err) {
                showToast('Ошибка', 'Ошибка при скачивании файла', 'error');
            } finally {
                if (a && typeof a.remove === 'function') {
                    try { a.remove(); } catch (err) {}
                }
                if (objUrl && window.URL && typeof window.URL.revokeObjectURL === 'function') {
                    try { window.URL.revokeObjectURL(objUrl); } catch (err) {}
                }
            }
        }

