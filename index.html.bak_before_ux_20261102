        function setCategoryFilter(category) {
            currentDeptFilter = category;
            document.querySelectorAll('.filter-pill').forEach(btn => {
                btn.classList.toggle('active', btn.dataset.dept === category);
            });
            renderTopics();
        }

        function renderTopics() {
            const grid = document.getElementById('topicsGrid');
            if (!grid) return;

            const search = document.getElementById('searchInput')?.value?.toLowerCase() || '';
            const supervisor = document.getElementById('supervisorFilter')?.value || 'all';
            const workType = document.getElementById('workTypeFilter')?.value || 'all';
            const avail = document.getElementById('availabilityFilter')?.value || 'all';

            const filtered = allTopics.filter(t => {
                const matchesSearch = (t.title || '').toLowerCase().includes(search) ||
                                      (t.supervisor_name || '').toLowerCase().includes(search) ||
                                      (t.tags && t.tags.toLowerCase().includes(search)) ||
                                      (t.required_skills && t.required_skills.toLowerCase().includes(search));
                
                const matchesDept = currentDeptFilter === 'all' || t.category === currentDeptFilter || t.department === currentDeptFilter;
                const matchesSupervisor = supervisor === 'all' || (t.supervisor_name || '') === supervisor;
                const matchesWorkType = workType === 'all' || t.work_type === workType;
                
                const isFull = t.quota_used >= t.quota_total || t.status === 'full';
                const matchesAvail = avail === 'all' || (avail === 'available' && !isFull) || (avail === 'full' && isFull);

                return matchesSearch && matchesDept && matchesSupervisor && matchesWorkType && matchesAvail;
            });

            if (filtered.length === 0) {
                grid.innerHTML = `<div class="col-span-full py-16 text-center text-[#4A5873] dark:text-[#9FB0CC] text-sm font-semibold">${tr('noTopicsFound', 'По вашему запросу тем не найдено')}</div>`;
                return;
            }

            const t = dict[currentLang] || dict.ru;

            grid.innerHTML = filtered.map(item => {
                const isFull = item.quota_used >= item.quota_total || item.status === 'full';
                const remaining = Math.max(0, item.quota_total - item.quota_used);
                
                // Трафик-лайт индикатор квоты
                let quotaBadge = '';
                if (isFull) {
                    quotaBadge = `<span class="px-2 py-0.5 rounded-md text-[11px] font-semibold bg-red-100 text-red-800 dark:bg-red-950/60 dark:text-red-300">${t.quotaFull}</span>`;
                } else if (remaining === 1) {
                    quotaBadge = `<span class="px-2 py-0.5 rounded-md text-[11px] font-semibold bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300">${t.quotaOne}</span>`;
                } else {
                    quotaBadge = `<span class="px-2 py-0.5 rounded-md text-[11px] font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300">${remaining} ${t.quotaFree}</span>`;
                }

                // Заголовок темы с поддержкой языка
                const displayTitle = (currentLang === 'kz' && item.title_kz) ? item.title_kz : ((currentLang === 'en' && item.title_en) ? item.title_en : (item.title_ru || item.title));

                return `
                    <div class="card-apple bg-[#FFFFFF] dark:bg-[#111A2E] border border-[#DCE2EE] dark:border-[#24324F] rounded-2xl p-5 flex flex-col justify-between shadow-xs hover:border-[#2447B8]/50 transition">
                        <div>
                            <div class="flex items-center justify-between gap-2 mb-2.5">
                                <span class="text-[11px] font-semibold uppercase tracking-wider text-[#2447B8] dark:text-[#3B6CF0]">${escapeHtml(item.category || item.department)}</span>
                                <div class="flex items-center gap-1">
                                    <span class="text-[11px] font-medium text-[#4A5873] dark:text-[#9FB0CC]">Сложность: ${escapeHtml(item.difficulty)}/5</span>
                                </div>
                            </div>
                            <h3 class="font-bold text-sm text-[#0F1B33] dark:text-[#EAF0FB] mb-1.5 leading-snug line-clamp-2" title="${escapeHtml(displayTitle)}">
                                ${escapeHtml(displayTitle)}
                            </h3>
                            <div class="text-xs text-[#4A5873] dark:text-[#9FB0CC] font-normal mb-3">
                                Руководитель: <span class="font-medium text-[#0F1B33] dark:text-[#EAF0FB]">${escapeHtml(item.supervisor_name)}</span>
                            </div>
                            <div class="flex flex-wrap gap-1 mb-4">
                                ${(item.tags || '').split(',').map(tag => tag.trim() ? `<span class="px-2 py-0.5 rounded-lg text-[10px] font-medium bg-[#F4F6FA] dark:bg-[#0B1220] text-[#4A5873] dark:text-[#9FB0CC] border border-[#DCE2EE] dark:border-[#24324F]">${escapeHtml(tag)}</span>` : '').join('')}
                            </div>
                        </div>

                        <div class="pt-3.5 border-t border-[#DCE2EE] dark:border-[#24324F] flex items-center justify-between">
                            <div>${quotaBadge}</div>
                            <div class="flex items-center gap-1.5">
                                <button onclick="openPassportModal(${item.id})" title="Паспорт темы" class="px-2.5 py-1.5 rounded-xl text-xs font-medium text-[#4A5873] dark:text-[#9FB0CC] hover:text-[#0F1B33] dark:hover:text-[#EAF0FB] hover:bg-[#E6ECFB] dark:hover:bg-[#24324F] transition border border-[#DCE2EE] dark:border-[#24324F] cursor-pointer">
                                    Паспорт
                                </button>
                                <button onclick="openApplyModal(${item.id}, decodeURIComponent('${encodeURIComponent(displayTitle || '')}'), decodeURIComponent('${encodeURIComponent(item.supervisor_name || '')}'))" ${isFull ? 'disabled' : ''} class="${isFull ? 'opacity-50 cursor-not-allowed bg-slate-200 dark:bg-slate-800 text-slate-400' : 'bg-[#2447B8] hover:bg-[#1B3794] text-white shadow-xs'} px-3.5 py-1.5 rounded-xl text-xs font-semibold transition cursor-pointer">
                                    ${isFull ? t.quotaFull : t.btnApply}
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function scrollToCatalog() {
            if (currentUser && currentUser.role === 'student') {
                switchStudentTab('catalog');
                document.getElementById('studentTabContentCatalog')?.scrollIntoView({ behavior: 'smooth' });
            } else if (!currentUser) {
                openAuthModal('login');
            }
        }

        // ─── 16. МОДАЛКА ПОДАЧИ ЗАЯВКИ С ВЫБОРОМ ПРИОРИТЕТА (1, 2, 3) ───
        function openApplyModal(topicId, topicTitle, supervisorName) {
            if (!currentUser) {
                showToast('Требуется авторизация', 'Войдите в систему для подачи заявки', 'warning');
                openAuthModal('login');
                return;
            }
            if (currentUser.role !== 'student') {
                showToast('Ограничение роли', 'Только студенты могут подавать заявки на темы', 'error');
                return;
            }

            document.getElementById('applyTopicId').value = topicId;
            document.getElementById('applyModalTopicTitle').textContent = topicTitle;
            document.getElementById('applyModalSupervisor').textContent = `Научный руководитель: ${supervisorName}`;
            document.getElementById('applyMotivationInput').value = '';

            const modal = document.getElementById('applyModal');
            if (modal) { notifyModalOpen(modal); }
        }

        function closeApplyModal() {
            const modal = document.getElementById('applyModal');
            notifyModalClose(modal);
        }

        async function handleApplySubmit(e) {
            e.preventDefault();
            const topicId = parseInt(document.getElementById('applyTopicId')?.value);
            const priorityInput = document.querySelector('input[name="applyPriority"]:checked');
            const priority = priorityInput ? parseInt(priorityInput.value) : 1;
            const motivation = document.getElementById('applyMotivationInput')?.value?.trim() || 'Подано через платформу META';
            const btn = document.getElementById('applySubmitBtn');

            if (btn) btn.disabled = true;
            btn.textContent = 'Отправка...';

            try {
                const res = await apiFetch('/api/applications/apply', {
                    method: 'POST',
                    body: {
                        topic_id: topicId,
                        priority: priority,
                        motivation: motivation
                    }
                });
                const data = await res.json();

                if (res.ok) {
                    showToast('Заявка отправлена', `Приоритет №${priority} успешно зарегистрирован кафедрой`, 'success');
                    closeApplyModal();
                    loadStudentDashboard();
                    loadTopics();
                } else {
                    showToast('Не удалось подать заявку', data.detail || 'Проверьте условия подачи', 'error');
                }
            } catch (err) {
                showToast('Ошибка сети', 'Не удалось связаться с сервером', 'error');
            } finally {
                if (btn) btn.disabled = false;
                btn.textContent = 'Отправить заявку';
            }
        }

        // ─── 17. ИНИЦИАТИВНАЯ ТЕМА СТУДЕНТА + AI-АССИСТЕНТ ───
        function openCustomTopicModal() {
            if (!currentUser || currentUser.role !== 'student') {
                showToast('Требуется авторизация', 'Войдите как студент для предложения темы', 'warning');
                return;
            }
            const modal = document.getElementById('customTopicModal');
            if (modal) { notifyModalOpen(modal); }
        }

        function closeCustomTopicModal() {
            const modal = document.getElementById('customTopicModal');
            notifyModalClose(modal);
        }

        async function handleAiRefineTopic() {
            const rawIdea = document.getElementById('customIdeaInput')?.value?.trim();
            if (!rawIdea) {
                showToast('Введите идею', 'Опишите проект простыми словами', 'warning');
                return;
            }

            const btn = document.getElementById('customAiRefineBtn');
            if (btn) btn.disabled = true;
            btn.innerHTML = '<span>Формулирование академической темы...</span>';

            try {
                const res = await apiFetch('/api/ai/refine-topic', {
                    method: 'POST',
                    body: { raw_idea: rawIdea }
                });
                const data = await res.json();

                document.getElementById('aiResTitleRu').textContent = data.title_ru;
                document.getElementById('aiResTitleKz').textContent = data.title_kz;
                document.getElementById('aiResTitleEn').textContent = data.title_en;
                document.getElementById('aiResCategory').textContent = data.category;
                document.getElementById('aiResDifficulty').textContent = `${data.difficulty} / 5`;
                
                const kwContainer = document.getElementById('aiResKeywords');
                kwContainer.innerHTML = (data.keywords || []).map(kw => `<span class="px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-700 text-[11px] font-medium border border-slate-200 dark:border-slate-600">${escapeHtml(kw)}</span>`).join('');

                document.getElementById('customAiResultBlock').classList.remove('hidden');
                showToast('Формулировка завершена', 'Тема и характеристики успешно подобраны', 'success');
            } catch (e) {
                showToast('Ошибка', 'Не удалось сформулировать тему', 'error');
            } finally {
                if (btn) btn.disabled = false;
                btn.innerHTML = '<span>Сформировать академическую тему</span>';
            }
        }

        async function handleDuplicateCheck() {
            const titleRu = document.getElementById('aiResTitleRu')?.textContent;
            if (!titleRu) return;

            const resDiv = document.getElementById('customDupResult');
            resDiv.className = 'mt-3 p-3 rounded-lg text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 border border-slate-200 dark:border-slate-700';
            resDiv.textContent = 'Проверка базы дипломных тем...';
            resDiv.classList.remove('hidden');

            try {
                const res = await apiFetch('/api/topics/check-duplicate', {
                    method: 'POST',
                    body: { title: titleRu }
                });
                const data = await res.json();

                if (data.is_duplicate) {
                    resDiv.className = 'mt-3 p-3 rounded-lg text-xs font-semibold bg-rose-50 dark:bg-rose-950/60 text-rose-700 dark:text-rose-300 border border-rose-200 dark:border-rose-900';
                    resDiv.textContent = `Высокое сходство (${data.similarity}% с темой «${data.matched_topic}»). Рекомендуется скорректировать формулировку.`;
                } else {
                    resDiv.className = 'mt-3 p-3 rounded-lg text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-900';
                    resDiv.textContent = `Тема уникальна (максимальное сходство ${data.similarity}%). Доступна к согласованию.`;
                }
            } catch (e) {
                resDiv.textContent = 'Ошибка проверки на дубликаты';
            }
        }

        async function submitCustomTopicProposal() {
            const titleRu = document.getElementById('aiResTitleRu')?.textContent;
            const titleKz = document.getElementById('aiResTitleKz')?.textContent;
            const titleEn = document.getElementById('aiResTitleEn')?.textContent;
            const category = document.getElementById('aiResCategory')?.textContent || 'WEB';
            const rawIdea = document.getElementById('customIdeaInput')?.value?.trim();
            const btn = document.getElementById('customSubmitBtn');

            if (!titleRu) {
                showToast('Ошибка', 'Сначала сформулируйте тему через AI-ассистента', 'warning');
                return;
            }

            if (btn) { btn.disabled = true; btn.textContent = 'Отправка...'; }
            try {
                const res = await apiFetch('/api/custom-topics', {
                    method: 'POST',
                    body: {
                        title_raw: rawIdea || titleRu,
                        title_ru: titleRu,
                        title_kz: titleKz,
                        title_en: titleEn,
                        category: category,
                        difficulty: 4
                    }
                });
                const data = await res.json();
                if (res.ok) {
                    showToast('Тема отправлена', 'Инициативная тема передана научному руководителю', 'success');
                    closeCustomTopicModal();
                    loadStudentDashboard();
                } else {
                    showToast('Ошибка', data.detail || 'Не удалось отправить предложение', 'error');
                }
            } catch (e) {
                showToast('Ошибка сети', 'Сбой при отправке предложения', 'error');
            } finally {
                if (btn) { btn.disabled = false; btn.textContent = 'Отправить тему на согласование кафедры'; }
            }
        }

        // ─── 18. ПАСПОРТ ТЕМЫ ───
        async function openPassportModal(topicId) {
            try {
                const res = await apiFetch(`/api/topics/${topicId}/passport`);
                const data = await res.json();

                document.getElementById('passportTitle').textContent = data.title_ru || data.title;
                document.getElementById('passportSupervisor').textContent = `Научный руководитель: ${data.supervisor_name} (${data.department})`;
                document.getElementById('passportSkills').textContent = data.required_skills || 'Python, SQL';
                document.getElementById('passportDifficulty').textContent = `${data.difficulty} / 5`;
                document.getElementById('passportQuota').textContent = `${data.quota_used} из ${data.quota_total} мест занято`;
                document.getElementById('passportHwSw').textContent = data.hardware_software_requirements || 'ПК со средой разработки';
                document.getElementById('passportResult').textContent = data.expected_result || 'Программный прототип и пояснительная записка';

                const pastList = document.getElementById('passportPastWorks');
                if (pastList) {
                    pastList.innerHTML = (data.past_works || []).map(w => `
                        <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 flex justify-between items-center">
                            <div>
                                <b class="text-slate-900 dark:text-white font-semibold">${escapeHtml(w.student)} (${escapeHtml(w.year)})</b>
                                <div class="text-[10px] text-slate-500">${escapeHtml(w.outcome)}</div>
                            </div>
                            <span class="text-xs font-bold text-emerald-700 dark:text-emerald-400">${escapeHtml(w.grade)}</span>
                        </div>
                    `).join('');
                }

                const modal = document.getElementById('passportModal');
                if (modal) { notifyModalOpen(modal); }
            } catch (e) {
                showToast('Ошибка', 'Не удалось загрузить паспорт темы', 'error');
            }
        }

        function closePassportModal() {
            const modal = document.getElementById('passportModal');
            notifyModalClose(modal);
        }

        // ─── 19. МОДУЛЬ НОРМОКОНТРОЛЯ (.DOCX) ───
        function openNormControlModal() {
            const modal = document.getElementById('normControlModal');
            if (modal) { notifyModalOpen(modal); }
        }

        function closeNormControlModal() {
            const modal = document.getElementById('normControlModal');
            notifyModalClose(modal);
        }

        function handleNormFileSelected(input) {
            if (input.files && input.files.length > 0) {
                selectedNormFile = input.files[0];
                const lbl = document.getElementById('normDocxFileName');
                if (lbl) lbl.textContent = `Выбран файл: ${selectedNormFile.name} (${Math.round(selectedNormFile.size / 1024)} КБ)`;
            }
        }

        async function runNormControlCheck() {
            if (!selectedNormFile) {
                showToast('Выберите файл', 'Прикрепите документ .docx для проверки', 'warning');
                return;
            }

            const btn = document.getElementById('normCheckBtn');
            const btnText = document.getElementById('normCheckBtnText');
            if (btn) btn.disabled = true;
            btnText.textContent = 'Анализ документа по ГОСТ...';

            const formData = new FormData();
            formData.append('file', selectedNormFile);

            try {
                const res = await apiFetch('/api/norm-control/check-docx', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();

                if (!res.ok) {
                    showToast('Ошибка проверки', data.detail || 'Не удалось проверить файл', 'error');
                    return;
                }

                // Отображение результатов
                const resultBlock = document.getElementById('normResultBlock');
                const scoreBadge = document.getElementById('normScoreBadge');
                const statusPill = document.getElementById('normStatusPill');
                const checksList = document.getElementById('normChecksList');
                const recsBlock = document.getElementById('normRecommendationsBlock');
                const recsList = document.getElementById('normRecommendationsList');

                scoreBadge.textContent = `${data.score} / 100`;
                statusPill.textContent = data.status;
                if (data.score >= 85) {
                    statusPill.className = 'px-3 py-1 rounded-md text-xs font-semibold uppercase bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800';
                } else if (data.score >= 65) {
                    statusPill.className = 'px-3 py-1 rounded-md text-xs font-semibold uppercase bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300 border border-amber-200 dark:border-amber-800';
                } else {
                    statusPill.className = 'px-3 py-1 rounded-md text-xs font-semibold uppercase bg-red-100 text-red-800 dark:bg-red-950/60 dark:text-red-300 border border-red-200 dark:border-red-800';
                }

                checksList.innerHTML = (data.checks || []).map(c => `
                    <div class="flex items-start gap-2.5 p-2 rounded-lg ${c.passed ? 'bg-emerald-50/60 dark:bg-emerald-950/20 text-emerald-800 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-900/40' : 'bg-red-50/60 dark:bg-red-950/20 text-red-800 dark:text-red-300 border border-red-200/60 dark:border-red-900/40'}">
                        <span class="text-xs leading-none mt-1 font-bold">${c.passed ? '✓' : '✕'}</span>
                        <div class="flex-1">
                            <div class="font-semibold text-xs">${escapeHtml(c.title)}</div>
                            <div class="text-[11px] opacity-80 mt-0.5">${escapeHtml(c.detail)}</div>
                        </div>
                    </div>
                `).join('');

                if (data.recommendations && data.recommendations.length > 0) {
                    recsList.innerHTML = data.recommendations.map(r => `<li>${escapeHtml(r)}</li>`).join('');
                    recsBlock.classList.remove('hidden');
                } else {
                    recsBlock.classList.add('hidden');
                }

                resultBlock.classList.remove('hidden');
                showToast('Аудит завершен', `Общий балл ГОСТ: ${data.score}/100 (${data.status})`, 'success');
            } catch (e) {
                showToast('Ошибка сети', 'Сбой при отправке на нормоконтроль', 'error');
            } finally {
                if (btn) btn.disabled = false;
                btnText.textContent = 'Проверить документ на соответствие ГОСТ';
            }
        }

        // ─── 20. ИНИЦИАЛИЗАЦИЯ ПРИ ЗАГРУЗКЕ СТРАНИЦЫ (DOMContentLoaded) ───
        window.addEventListener('DOMContentLoaded', () => {
            // 1. Инициализация темы из localStorage
            initTheme();

            // 2. Немедленное восстановление пользователя до рендеринга языка
            const savedToken = localStorage.getItem('meta_token');
            const savedUser = localStorage.getItem('meta_user');
            if (savedToken && savedUser) {
                try {
                    currentUser = JSON.parse(savedUser);
                } catch (e) {
                    currentUser = null;
                }
            }

            // 3. Инициализация языка (применит язык ко всему интерфейсу и личному кабинету)
            setLanguage(currentLang);

            // 4. Фоновая валидация токена через backend (с защитой от устаревшей сессии)
            if (savedToken) {
                apiFetch('/api/auth/me').then(res => {
                    if (res && res.ok) {
                        return res.json();
                    } else {
                        throw new Error('Invalid session');
                    }
                }).then(freshUser => {
                    currentUser = freshUser;
                    localStorage.setItem('meta_user', JSON.stringify(freshUser));
                    updateUserInterface();
                }).catch(err => {
                    console.warn('Session verification failed on restore:', err);
                    logout(true);
                });
            } else {
                localStorage.removeItem('meta_user');
                currentUser = null;
                updateUserInterface();
            }

            // 3. Загрузка каталога тем
            loadTopics();

            // Привязка клика по главной кнопке входа
            const mainLoginBtn = document.getElementById('loginBtn');
            if (mainLoginBtn) {
                mainLoginBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    openAuthModal('login');
                });
            }

            // Доступность: закрытие по Escape и фокус-ловушка (Tab Trap)
            window.addEventListener('keydown', handleModalKeydown);
        });
    </script>
