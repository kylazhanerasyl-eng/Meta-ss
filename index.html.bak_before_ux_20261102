    <style>
        /* ─── META: дизайн-токены (университетский синий, акцент — янтарный для предупреждений) ─── */
        :root {
            --bg: #F4F6FA;
            --surface: #FFFFFF;
            --surface-raised: #FFFFFF;
            --header-bg: rgba(255, 255, 255, 0.97);
            --text: #0F1B33;
            --text-muted: #4A5873;
            --border: #DCE2EE;
            --accent: #2447B8;
            --accent-hover: #1B3794;
            --accent-soft: #E6ECFB;
            --focus-ring: rgba(36, 71, 184, 0.35);
            --radius: 12px;
        }
        html.dark {
            --bg: #0B1220;
            --surface: #111A2E;
            --surface-raised: #17223A;
            --header-bg: rgba(15, 24, 48, 0.97);
            --text: #EAF0FB;
            --text-muted: #9FB0CC;
            --border: #24324F;
            --accent: #3B6CF0;
            --accent-hover: #5A84F5;
            --accent-soft: rgba(59, 108, 240, 0.18);
            --focus-ring: rgba(107, 148, 255, 0.5);
        }
        html { scroll-behavior: smooth; }
        body {
            background-color: var(--bg) !important;
            color: var(--text) !important;
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
            font-feature-settings: "tnum" 1, "cv11" 1;
        }
        header { z-index: 50 !important; background-color: var(--header-bg) !important; border-bottom: 1px solid var(--border) !important; }
        button, a, [role="button"] { cursor: pointer; }
        button:disabled, [aria-disabled="true"] { cursor: not-allowed; }
        .modal-backdrop { position: fixed !important; z-index: 100 !important; }
        #toastContainer { z-index: 200 !important; }

        /* Поверхности */
        .card-apple {
            background-color: var(--surface) !important;
            border: 1px solid var(--border) !important;
            border-radius: var(--radius) !important;
            box-shadow: 0 1px 2px rgba(15, 27, 51, 0.05);
            transition: border-color .15s ease, box-shadow .15s ease;
        }
        .card-apple:hover { border-color: var(--accent) !important; box-shadow: 0 4px 14px -4px rgba(15, 27, 51, 0.14); }
        html.dark .card-apple { color: var(--text) !important; box-shadow: none; }
        html.dark .card-apple:hover { box-shadow: 0 6px 16px -6px rgba(0, 0, 0, 0.6); }
        html.dark h1, html.dark h2, html.dark h3, html.dark strong { color: var(--text) !important; }
        html.dark .text-slate-900 { color: var(--text) !important; }
        html.dark .text-slate-700, html.dark .text-slate-600 { color: var(--text-muted) !important; }
        html.dark input, html.dark select, html.dark textarea {
            background-color: #0D1526 !important; color: var(--text) !important; border-color: var(--border) !important;
        }
        input::placeholder, textarea::placeholder { color: var(--text-muted); opacity: .7; }

        /* Кнопки */
        .btn-gradient, .btn-brand {
            background-color: var(--accent) !important; color: #FFFFFF !important;
            border: 1px solid var(--accent) !important; border-radius: 10px !important;
            transition: background-color .15s ease, border-color .15s ease, transform .1s ease;
        }
        .btn-gradient:hover, .btn-brand:hover { background-color: var(--accent-hover) !important; border-color: var(--accent-hover) !important; }
        .btn-gradient:active, .btn-brand:active { transform: translateY(1px); }
        .btn-gradient:disabled, .btn-brand:disabled { opacity: .5; transform: none; }
        .btn-dark {
            background: #142038 !important; color: #FFFFFF !important; border: 1px solid #142038 !important;
            border-radius: 10px !important; transition: background-color .15s ease;
        }
        .btn-dark:hover { background: #1F2E50 !important; border-color: #1F2E50 !important; }
        html.dark .btn-dark { background: var(--surface-raised) !important; border-color: var(--border) !important; color: var(--text) !important; }
        html.dark .btn-dark:hover { background: #26365A !important; border-color: #31426A !important; }

        /* Фильтры */
        .filter-pill {
            padding: 5px 12px; border-radius: 8px; font-size: 12px; font-weight: 500;
            border: 1px solid var(--border); background: var(--surface); color: var(--text-muted);
            transition: background-color .15s ease, color .15s ease, border-color .15s ease;
        }
        .filter-pill:hover { background: var(--accent-soft); color: var(--accent); border-color: var(--accent); }
        .filter-pill.active { background: var(--accent) !important; color: #FFFFFF !important; border-color: var(--accent) !important; font-weight: 600; }
        html.dark .filter-pill:hover { color: #8FB0FF; }

        .bg-grid, .glow-hero, .glow-bg { display: none !important; }

        /* Фокус: поля и клавиатура */
        input:focus, select:focus, textarea:focus {
            outline: none !important; border-color: var(--accent) !important; box-shadow: 0 0 0 3px var(--focus-ring) !important;
        }
        :focus-visible { outline: 2px solid var(--accent) !important; outline-offset: 2px !important; }
        html.dark :focus-visible { outline-color: #6B94FF !important; }

        /* Уведомления и прокрутка */
        .toast-item { animation: slideIn .25s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        @keyframes slideIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(74, 88, 115, 0.28); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(74, 88, 115, 0.5); }

        /* Таблицы и длинные тексты: ничего не вылезает за границы */
        table { border-collapse: collapse; }
        .overflow-x-auto { -webkit-overflow-scrolling: touch; }
        /* Широкие таблицы прокручиваются по горизонтали, а не сжимают колонки до вертикального текста */
        .overflow-x-auto > table { min-width: 760px; }
        .overflow-x-auto > table th { white-space: nowrap; }
        h1, h2, h3, td, th, p, li { overflow-wrap: anywhere; }
        main, section { min-width: 0; }

        .border-b > button { white-space: nowrap; flex-shrink: 0; }
        section > .border-b, section > div.flex.items-center.gap-2.border-b { overflow-x: auto; }


        /* Кабинет индустриального партнёра */
        .co-grid { display: grid; grid-template-columns: minmax(0, 340px) minmax(0, 1fr); gap: 28px; }
        @media (max-width: 900px) { .co-grid { grid-template-columns: minmax(0, 1fr); } }
        .co-form { display: flex; flex-direction: column; gap: 6px; }
        .co-h { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--text); margin-bottom: 8px; }
        .co-label { font-size: 12px; font-weight: 600; color: var(--text-muted); margin-top: 8px; }
        .co-input { width: 100%; padding: 9px 12px; font-size: 14px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); color: var(--text); }
        .co-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .co-check { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--text); margin-top: 10px; }
        .co-submit { margin-top: 16px; padding: 10px 16px; font-size: 14px; font-weight: 600; }
        .co-list { display: flex; flex-direction: column; gap: 10px; }
        .co-item { border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; background: var(--surface); }
        .co-item b { display: block; font-size: 14px; color: var(--text); }
        .co-item span { font-size: 12px; color: var(--text-muted); }
        .co-empty { font-size: 13px; color: var(--text-muted); padding: 14px; border: 1px dashed var(--border); border-radius: 10px; }

