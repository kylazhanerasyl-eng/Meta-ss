                    body: { status: decision, comment: decision === 'SUPERVISOR_APPROVED' ? 'Тема согласована научным руководителем' : 'Тема отклонена' }
                });
                if (res.ok) {
                    showToast('Решение сохранено', '', 'success');
                    loadTeacherProposals();
                }
            } catch (e) {}
