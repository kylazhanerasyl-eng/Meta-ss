                        <option value="student">Студент</option>
                        <option value="teacher">Преподаватель (Научный руководитель)</option>
                    </select>
                </div>

                <div id="authErrorMsg" class="hidden p-2.5 bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-400 text-xs font-medium rounded-xl border border-red-200 dark:border-red-900"></div>

                <button id="authSubmitBtn" type="submit" class="w-full bg-[#2447B8] hover:bg-[#1B3794] text-white py-2.5 rounded-xl font-semibold text-xs shadow-sm mt-3 cursor-pointer flex items-center justify-center gap-2 transition">
