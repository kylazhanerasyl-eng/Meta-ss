        function showToast(title, message, type = 'success', icon = null) {
            const container = document.getElementById('toastContainer');
            if (!container) return;

            const toast = document.createElement('div');
            toast.className = 'toast-item pointer-events-auto flex items-start gap-3 px-4 py-3 rounded-xl shadow-lg text-white text-xs font-medium max-w-sm backdrop-blur-md transition-all duration-300';
            
            const colorMap = {
                success: 'bg-emerald-700 border border-emerald-600',
                error: 'bg-red-700 border border-red-600',
                warning: 'bg-amber-700 border border-amber-600',
                info: 'bg-slate-800 border border-slate-700'
            };
            const defaultIcons = {
                success: '✓',
                error: '✕',
                warning: '!',
                info: 'i'
            };

            toast.className += ` ${colorMap[type] || colorMap.info}`;
            toast.innerHTML = `
                <span class="w-5 h-5 rounded-full bg-white/20 flex items-center justify-center text-xs font-bold leading-none mt-0.5 flex-shrink-0">${icon || defaultIcons[type] || 'i'}</span>
                <div class="flex-1">
                    <div class="font-bold text-sm leading-tight">${escapeHtml(title)}</div>
                    <div class="opacity-90 mt-0.5 leading-snug">${escapeHtml(message || '')}</div>
                </div>
            `;

            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(10px) scale(0.95)';
                setTimeout(() => toast.remove(), 350);
            }, 4500);
        }

        async function copyDecreeHash(event) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }
            const hashEl = document.getElementById('headOrderHashBadge');
            if (!hashEl) return;

            let hashText = (hashEl.dataset && hashEl.dataset.hash) ? hashEl.dataset.hash : (hashEl.textContent || '').trim();

            const isPlaceholder = !hashText ||
                hashText === '—' ||
                hashText === '-' ||
                hashText === tr('orderStatusVerified', 'Сформирован и верифицирован') ||
                hashText === tr('orderStatusFormed', 'Сформирован в цифровом реестре ASTRA');

            if (isPlaceholder) {
                showToast(tr('info', 'Информация'), tr('noHashToCopy', 'Хэш приказа еще не сформирован'), 'warning');
                return;
            }

            let success = false;
            try {
                if (navigator.clipboard && window.isSecureContext && typeof navigator.clipboard.writeText === 'function') {
                    await navigator.clipboard.writeText(hashText);
                    success = true;
                } else {
                    throw new Error('Clipboard API unavailable');
                }
            } catch (clipErr) {
                try {
                    const tempArea = document.createElement('textarea');
                    tempArea.value = hashText;
                    tempArea.setAttribute('readonly', '');
                    tempArea.style.position = 'fixed';
                    tempArea.style.left = '-9999px';
                    tempArea.style.top = '-9999px';
                    tempArea.style.opacity = '0';
                    document.body.appendChild(tempArea);
                    tempArea.focus();
                    tempArea.select();
                    success = document.execCommand('copy');
                    document.body.removeChild(tempArea);
                } catch (fallbackErr) {
                    success = false;
                }
            }

            const iconCopy = document.getElementById('copyHashIcon');
            const iconSuccess = document.getElementById('copyHashSuccessIcon');

            if (success) {
                if (iconCopy && iconSuccess) {
                    iconCopy.classList.add('hidden');
                    iconSuccess.classList.remove('hidden');
                    setTimeout(() => {
                        iconCopy.classList.remove('hidden');
                        iconSuccess.classList.add('hidden');
                    }, 2000);
                }
                showToast(tr('success', 'Успешно'), tr('hashCopied', 'SHA-256 хэш скопирован в буфер обмена'), 'success');
            } else {
                try {
                    const range = document.createRange();
                    range.selectNodeContents(hashEl);
                    const sel = window.getSelection();
                    sel.removeAllRanges();
                    sel.addRange(range);
                } catch (e) {}
                showToast(tr('error', 'Ошибка'), tr('hashCopyError', 'Не удалось скопировать хэш. Выделите и нажмите Ctrl+C.'), 'error');
            }
        }

