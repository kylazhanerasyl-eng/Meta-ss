:root{--bg:#F6F5F2;--surface:#FFFFFF;--surface-raised:#FFFFFF;--header-bg:rgba(255,255,255,.96);--text:#1B2230;--text-muted:#5F6878;--border:#E3E1DA;--accent:#2B4C9B;--accent-hover:#223F83;--accent-soft:#E9EEF9;--focus-ring:rgba(43,76,155,.28);--radius:10px}
html.dark{--bg:#10141C;--surface:#171C26;--surface-raised:#1D2330;--header-bg:rgba(16,20,28,.96);--text:#E8EBF1;--text-muted:#98A1B3;--border:#283041;--accent:#5B84E6;--accent-hover:#7A9AEE;--accent-soft:rgba(91,132,230,.16);--focus-ring:rgba(122,154,238,.4)}
html,body,button,input,select,textarea{font-family:'Inter','Segoe UI',system-ui,-apple-system,Roboto,Arial,sans-serif!important}
body{font-size:14px;line-height:1.5;letter-spacing:-.003em;font-feature-settings:"cv11" 1,"ss03" 1}
h1,h2,h3{letter-spacing:-.015em}
/* подписи: без КАПСА и растянутого трекинга */
.uppercase{text-transform:none!important}
.tracking-wider,.tracking-widest,.tracking-wide,[class*="tracking-["]{letter-spacing:0!important}
th{font-size:12px!important;font-weight:600!important;color:var(--text-muted)!important;background:transparent!important}
.co-h{text-transform:none;letter-spacing:0;font-size:14px}
/* контуры: тонкая нейтральная рамка вместо синего свечения */
.card-apple,section>.rounded-2xl,section>.rounded-3xl,main .rounded-3xl{border-color:var(--border)!important;box-shadow:0 1px 2px rgba(20,24,34,.04)!important}
html.dark .card-apple,html.dark main .rounded-3xl{box-shadow:none!important}
.rounded-3xl{border-radius:16px!important}.rounded-2xl{border-radius:12px!important}
.shadow-xl,.shadow-2xl,.shadow-lg{box-shadow:0 1px 3px rgba(20,24,34,.08)!important}
[class*="shadow-blue"],[class*="shadow-indigo"],[class*="shadow-purple"]{box-shadow:none!important}
html.dark [class*="border-[#2447B8]"],html.dark [class*="border-blue-"]{border-color:var(--border)!important}
/* крупные цифры спокойнее */
.text-4xl{font-size:1.75rem!important;line-height:2rem!important;font-weight:650!important}
.text-5xl{font-size:2rem!important;line-height:2.25rem!important;font-weight:650!important}
.font-black,.font-extrabold{font-weight:650!important}
/* таблицы */
tbody tr{transition:background-color .12s}tbody tr:hover{background:var(--accent-soft)}
td,th{padding-top:12px!important;padding-bottom:12px!important}
/* кнопки и вкладки */
.btn-gradient,.btn-brand{box-shadow:none!important;font-weight:600!important}
header{backdrop-filter:saturate(1.2) blur(8px)}
.meta-landing{background:var(--bg)!important}
.meta-landing::before{display:none!important}
