        async function loadTopics() {
            try {
                const res = await apiFetch('/api/topics');
                allTopics = await res.json();

                // Динамическое заполнение фильтра научных руководителей
                const supSelect = document.getElementById('supervisorFilter');
                if (supSelect) {
                    const currentVal = supSelect.value;
                    const sups = Array.from(new Set(allTopics.map(t => t.supervisor_name).filter(Boolean))).sort();
                    supSelect.innerHTML = `<option value="all">${tr('allSupervisors', 'Все руководители')}</option>` +
                        sups.map(s => `<option value="${escapeHtml(s)}">${escapeHtml(s)}</option>`).join('');
                    if (currentVal && (currentVal === 'all' || sups.includes(currentVal))) {
                        supSelect.value = currentVal;
                    }
                }

                renderTopics();
            } catch (e) {
                console.warn('Failed to load topics:', e);
