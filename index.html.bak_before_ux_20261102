        function tr(key, fallback = '') {
            const langDict = dict[currentLang] || dict.ru || {};
            return (langDict[key] !== undefined) ? langDict[key] : ((dict.ru && dict.ru[key] !== undefined) ? dict.ru[key] : fallback);
