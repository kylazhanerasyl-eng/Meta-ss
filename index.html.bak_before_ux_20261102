    <!-- 5. Модалка нормоконтроля (.DOCX) -->
    <div id="normControlModal" class="hidden modal-backdrop inset-0 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
        <div class="bg-[#FFFFFF] dark:bg-[#111A2E] rounded-2xl p-7 max-w-2xl w-full shadow-2xl border border-[#DCE2EE] dark:border-[#24324F] relative max-h-[90vh] overflow-y-auto">
            <button onclick="closeNormControlModal()" class="absolute top-4 right-4 text-[#4A5873] hover:text-[#0F1B33] dark:text-[#9FB0CC] dark:hover:text-[#EAF0FB] text-lg font-bold cursor-pointer">✕</button>
            <div class="flex items-center gap-2 mb-1">
                <span class="text-xs font-semibold uppercase tracking-wide text-[#2447B8] dark:text-[#9DB4E6]">Нормоконтроль</span>
            </div>
