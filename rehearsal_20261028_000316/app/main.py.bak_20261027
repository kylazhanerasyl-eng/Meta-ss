class Preference(Base):
    __tablename__ = "preferences"
    __table_args__ = (
        UniqueConstraint("student_id", "priority", name="uq_preferences_student_priority"),
        UniqueConstraint("student_id", "topic_id", name="uq_preferences_student_topic"),
