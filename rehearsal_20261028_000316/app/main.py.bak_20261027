    role: str = "student"
    rating: Optional[float] = Field(default=3.5, ge=0, le=4, allow_inf_nan=False)
    gpa: Optional[float] = Field(default=None, ge=0, le=4, allow_inf_nan=False)
    group_name: Optional[str] = None
    student_number: Optional[str] = None
    skills: Optional[str] = ""

